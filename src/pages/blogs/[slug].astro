---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import BlogCard from "../../components/BlogCard.astro";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { url } from "../../utils/url-utils";

export async function getStaticPaths() {
	const blogPosts = await getCollection("blogs");
	return blogPosts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await post.render();
const { title, description, published, updated, image, tags, category, lang } =
	post.data;
const isKurdish = lang === "ku";

// Calculate reading time
const readingTime = (content) => {
	const wordsPerMinute = 200;
	const wordCount = content.split(/\s+/).length;
	return Math.ceil(wordCount / wordsPerMinute);
};

const readingMinutes = readingTime(post.body);

// "Read next": the next older article, wrapping around to the newest
const sortedBlogs = (await getCollection("blogs"))
	.filter((blog) => !blog.data.draft)
	.sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
const currentIndex = sortedBlogs.findIndex((blog) => blog.slug === post.slug);
const nextBlog =
	sortedBlogs.length > 1
		? sortedBlogs[(currentIndex + 1) % sortedBlogs.length]
		: undefined;
---

<MainGridLayout title={title} description={description || ""} headings={[]}>
  <div class="card-base pt-2" dir={isKurdish ? "rtl" : "ltr"} lang={isKurdish ? "ckb" : "en"}>
    <div class="pt-6 px-6 md:px-8">
      <header class="mb-0">
        <div class="flex flex-wrap gap-2  mb-0">
          {category && (
            <span class="chip h-8 px-3 text-sm !bg-[var(--primary-solid)] !text-[var(--on-primary)] !border-transparent">
              {category}
            </span>
          )}
          {tags && tags.map(tag => (
            <span class="chip h-8 px-3 text-sm" dir="ltr">
              {tag}
            </span>
          ))}
        </div>
        
        <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-4 pt-4 text-[var(--ink)]">{title}</h1>
        
        <div class="flex flex-wrap items-center gap-4 text-sm font-bold text-50">
          <span dir="ltr">{readingMinutes} min read</span>
          <span>•</span>
          <time datetime={published.toISOString()}>
            {published.toLocaleDateString("en-US", { 
              year: 'numeric', 
              month: 'long', 
              day: 'numeric' 
            })}
          </time>
        </div>
      </header>
    </div>

    {image && (
      <div class="w-full">
        <img
          src={image}
          alt={title}
          class="w-full h-auto max-h-[500px] object-cover"
        />
      </div>
    )}

    <div class="p-6 md:p-8 ">
      <div class="prose dark:prose-invert   markdown-content">
        <Content 
        
        />
      </div>
    </div>
  </div>

  <div class="flex flex-col gap-4 mt-4 mb-4">
    {nextBlog && (
      <div>
        <div class="text-sm font-extrabold text-50 uppercase tracking-wider mb-2 px-4 md:px-1">Read next</div>
        <BlogCard entry={nextBlog} />
      </div>
    )}
    <a href={url("/blogs/")} class="btn-outline self-start ms-4 md:ms-0">
      <Icon name="material-symbols:arrow-back-rounded" class="text-xl"></Icon>
      All articles
    </a>
  </div>
</MainGridLayout>

<style>
  .markdown-content {
    @apply space-y-6;
  }
  .markdown-content h2 {
    @apply text-2xl font-extrabold tracking-tight mt-8 mb-4;
  }
  .markdown-content h3 {
    @apply text-xl font-semibold mt-6 mb-3;
  }
  .markdown-content p {
    @apply my-4 leading-relaxed;
  }
  .markdown-content ul, 
  .markdown-content ol {
    @apply my-4 ps-6;
  }
  .markdown-content li {
    @apply mb-2;
  }
  .markdown-content a {
    @apply text-[var(--primary)];
  }
  .markdown-content blockquote {
    @apply border-s-4 border-[var(--primary)] ps-4 py-1 my-4 text-black/75 dark:text-white/75;
  }
</style>

<style is:global>
  /* rehype-autolink-headings anchors: only show while hovering the heading */
  .markdown-content :is(h1, h2, h3, h4) .anchor {
    opacity: 0;
    margin-inline-start: 0.35em;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .markdown-content :is(h1, h2, h3, h4):hover .anchor {
    opacity: 1;
  }

  /* Inline code as small chips; code blocks are styled by expressive-code */
  .markdown-content :not(pre) > code {
    padding: 0.1em 0.4em;
    border: 1px solid var(--card-border);
    border-radius: 6px;
    background: var(--inline-code-bg);
    color: var(--inline-code-color);
    font-size: 0.875em;
    font-weight: 700;
  }
  .markdown-content :not(pre) > code::before,
  .markdown-content :not(pre) > code::after {
    content: none;
  }
</style>