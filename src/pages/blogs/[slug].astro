---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import BlogCard from "../../components/BlogCard.astro";
import CopyLinkButton from "../../components/misc/CopyLinkButton.astro";
import I18nKey from "../../i18n/i18nKey";
import { formatDate, languages, toLang } from "../../i18n/lang";
import { useTranslations } from "../../i18n/translation";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getCategoryName } from "../../utils/content-utils";
import { localeUrl } from "../../utils/url-utils";

export async function getStaticPaths() {
	const blogPosts = await getCollection("blogs");
	return blogPosts.map((post) => ({
		params: { slug: post.slug },
		props: { post },
	}));
}

const { post } = Astro.props;
const { Content } = await post.render();
const { title, description, published, updated, image, tags, category, lang } =
	post.data;

// The page around the article follows the site language; the article card follows the post's own language
const pageLang = toLang(Astro.currentLocale);
const t = useTranslations(pageLang);
const postLang = toLang(lang);
const tPost = useTranslations(postLang);

// Calculate reading time
const readingTime = (content) => {
	const wordsPerMinute = 200;
	const wordCount = content.split(/\s+/).length;
	return Math.ceil(wordCount / wordsPerMinute);
};

const readingMinutes = readingTime(post.body);

// "Read next": the next older article, wrapping around to the newest
const sortedBlogs = (await getCollection("blogs"))
	.filter((blog) => !blog.data.draft)
	.sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
// Related articles: the ones sharing the most tags (then the same category), newest first
const others = sortedBlogs.filter((blog) => blog.slug !== post.slug);
const score = (blog: (typeof others)[number]) =>
	blog.data.tags.filter((tag) => tags.includes(tag)).length * 2 +
	(category && blog.data.category === category ? 1 : 0);
const relatedBlogs = others
	.map((blog, index) => ({ blog, index, score: score(blog) }))
	.sort((a, b) => b.score - a.score || a.index - b.index)
	.slice(0, 3)
	.map(({ blog }) => blog);
---

<MainGridLayout title={title} description={description || ""} headings={[]}>
  <!-- data-pagefind-body: articles show up in the site search -->
  <div class="card-base pt-2" data-reading-article dir={languages[postLang].dir} lang={languages[postLang].htmlLang} data-pagefind-body>
    <div class="pt-6 px-6 md:px-8">
      <header class="mb-0">
        <div class="flex flex-wrap gap-2  mb-0" data-pagefind-ignore>
          {category && (
            <span class="chip h-8 px-3 text-sm !bg-[var(--primary-solid)] !text-[var(--on-primary)] !border-transparent">
              {getCategoryName(category, postLang)}
            </span>
          )}
          {tags && tags.map(tag => (
            <span class="chip h-8 px-3 text-sm" dir="ltr">
              {tag}
            </span>
          ))}
        </div>
        
        <h1 class="text-3xl md:text-4xl font-extrabold tracking-tight mb-4 pt-4 text-[var(--ink)]">{title}</h1>
        
        <div class="flex flex-wrap items-center gap-4 text-sm font-bold text-50" data-pagefind-ignore>
          <span>{tPost(I18nKey.minRead, { minutes: readingMinutes })}</span>
          <span>•</span>
          <time datetime={published.toISOString()}>
            {formatDate(published, postLang, {
              year: 'numeric',
              month: 'long',
              day: 'numeric'
            })}
          </time>
          <CopyLinkButton lang={postLang} />
        </div>
      </header>
    </div>

    {image && (
      <div class="w-full">
        <img
          src={image}
          alt={title}
          class="w-full h-auto max-h-[500px] object-cover"
        />
      </div>
    )}

    <div class="p-6 md:p-8 ">
      <div class="prose dark:prose-invert !max-w-none markdown-content">
        <Content 
        
        />
      </div>
    </div>
  </div>

  <div class="flex flex-col gap-4 mt-4 mb-4">
    {relatedBlogs.length > 0 && (
      <section class="flex flex-col gap-4">
        <h2 class="text-sm font-extrabold text-50 uppercase tracking-wider px-4 md:px-1">{t(I18nKey.relatedArticles)}</h2>
        {relatedBlogs.map((blog) => <BlogCard entry={blog} />)}
      </section>
    )}
    <a href={localeUrl("/blogs/", pageLang)} class="btn-outline self-start ms-4 md:ms-0">
      <Icon name="material-symbols:arrow-back-rounded" class="text-xl rtl:-scale-x-100"></Icon>
      {t(I18nKey.allArticles)}
    </a>
  </div>
</MainGridLayout>

<style>
  .markdown-content {
    @apply space-y-6;
  }
  .markdown-content h2 {
    @apply text-2xl font-extrabold tracking-tight mt-8 mb-4;
  }
  .markdown-content h3 {
    @apply text-xl font-semibold mt-6 mb-3;
  }
  .markdown-content p {
    @apply my-4 leading-relaxed;
  }
  .markdown-content ul, 
  .markdown-content ol {
    @apply my-4 ps-6;
  }
  .markdown-content li {
    @apply mb-2;
  }
  .markdown-content a {
    @apply text-[var(--primary)];
  }
  .markdown-content blockquote {
    @apply border-s-4 border-[var(--primary)] ps-4 py-1 my-4 text-black/75 dark:text-white/75;
  }
</style>

<style is:global>
  /* rehype-autolink-headings anchors: only show while hovering the heading */
  .markdown-content :is(h1, h2, h3, h4) .anchor {
    opacity: 0;
    margin-inline-start: 0.35em;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }
  .markdown-content :is(h1, h2, h3, h4):hover .anchor {
    opacity: 1;
  }

  /* Inline code as small chips; code blocks are styled by expressive-code */
  .markdown-content :not(pre) > code {
    padding: 0.1em 0.4em;
    border: 1px solid var(--card-border);
    border-radius: 6px;
    background: var(--inline-code-bg);
    color: var(--inline-code-color);
    font-size: 0.875em;
    font-weight: 700;
  }
  .markdown-content :not(pre) > code::before,
  .markdown-content :not(pre) > code::after {
    content: none;
  }
</style>