---
import { getCollection } from "astro:content";
import BlogCard from "../../components/BlogCard.astro";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
import { getBlogPlatform } from "../../utils/blog-utils";

const allBlogs = await getCollection("blogs");

const publishedBlogs = allBlogs
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.published.getTime() - a.data.published.getTime());

const filters = [
	{ id: "all", label: "All", platform: null },
	{ id: "android", label: "Android", platform: "android" },
	{ id: "ios", label: "iOS", platform: "ios" },
].map((filter) => ({
	...filter,
	count: filter.platform
		? publishedBlogs.filter(
				(post) => getBlogPlatform(post.data.category) === filter.platform,
			).length
		: publishedBlogs.length,
}));

let delay = 0;
const interval = 50;
---

<MainGridLayout title="Blog" description="Read our latest blog posts">
    <div class="blogs">
        <!-- CSS-only filter, same pattern as the projects page -->
        <input type="radio" name="blog-filter" id="blog-filter-all" class="sr-only" checked />
        <input type="radio" name="blog-filter" id="blog-filter-android" class="sr-only" />
        <input type="radio" name="blog-filter" id="blog-filter-ios" class="sr-only" />

        <div class="card-base onload-animation flex flex-wrap items-center justify-between gap-3 p-3 mb-4">
            <div class="filter-tabs flex gap-1 p-1 rounded-full border border-[var(--card-border)]">
                {filters.map((filter) => (
                    <label for={`blog-filter-${filter.id}`} data-filter={filter.id}
                           class="cursor-pointer select-none px-4 h-10 inline-flex items-center rounded-full text-sm font-extrabold text-[var(--ink)] hover:text-[var(--primary)] transition">
                        {filter.label}
                        <span class="ml-1.5 text-xs opacity-60">{filter.count}</span>
                    </label>
                ))}
            </div>
            <div class="text-sm font-bold text-50 px-2 hidden sm:block">Fixes and tips from shipping real apps</div>
        </div>

        <div class="flex flex-col gap-4 mb-4">
            {publishedBlogs.map((blog) => (
                <div class="blog-item" data-platform={getBlogPlatform(blog.data.category)}>
                    <BlogCard
                        entry={blog}
                        class="onload-animation"
                        style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
                    />
                </div>
            ))}
        </div>
    </div>
</MainGridLayout>

<style>
    .blogs:has(#blog-filter-all:checked) label[data-filter="all"],
    .blogs:has(#blog-filter-android:checked) label[data-filter="android"],
    .blogs:has(#blog-filter-ios:checked) label[data-filter="ios"] {
        background: var(--primary-solid);
        color: var(--on-primary);
    }
    .blogs:has(#blog-filter-android:checked) .blog-item:not([data-platform="android"]),
    .blogs:has(#blog-filter-ios:checked) .blog-item:not([data-platform="ios"]) {
        display: none;
    }
    .blogs:has(input:focus-visible) .filter-tabs {
        outline: 2px solid var(--primary);
        outline-offset: 2px;
    }
</style>
