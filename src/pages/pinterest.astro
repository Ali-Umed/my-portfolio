---
import { Icon } from "astro-icon/components";
import {
	pinBoardLabels,
	pinBoards,
	pinImageUrl,
	pins,
} from "../data/pinterest";
import I18nKey from "../i18n/i18nKey";
import { toLang } from "../i18n/lang";
import { useTranslations } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const profileUrl = "https://www.pinterest.com/ali_umed/_created/";

// Pictures shown at first and added each time the visitor reaches the end
const PAGE_SIZE = 24;

// Board names can be Kurdish or Arabic, so the filters use plain ids like "b0"
const slug = (board: (typeof pinBoards)[number]) => `b${pinBoards.indexOf(board)}`;
const filters = [
	{ id: "all", label: t(I18nKey.filterAll), count: pins.length },
	...pinBoards.map((board) => ({
		id: slug(board),
		label: pinBoardLabels[board][lang],
		count: pins.filter((pin) => pin.boards.includes(board)).length,
	})),
];
---

<MainGridLayout title={t(I18nKey.pinterest)} description={t(I18nKey.pinterestDescription)}>
    <!-- Filters and loading more are in Layout.astro (setupPins), which also runs after swup page changes -->
    <div id="pins" data-page-size={PAGE_SIZE}>
        <div class="card-base onload-animation p-3 mb-4">
            <div class="flex flex-wrap items-center justify-between gap-3 mb-3 ps-2">
                <div class="flex items-center gap-3 min-w-0">
                    <Icon name="fa6-brands:pinterest" class="text-2xl text-[#e60023] shrink-0"></Icon>
                    <div class="font-extrabold text-[var(--ink)]">{t(I18nKey.pinterestDescription)}</div>
                </div>
                <a href={profileUrl} target="_blank" rel="me noopener" class="btn-outline">
                    {t(I18nKey.openOnPinterest)}
                    <Icon name="fa6-solid:arrow-up-right-from-square" class="text-xs"></Icon>
                </a>
            </div>
            <div class="flex flex-wrap gap-1" role="group">
                {filters.map((filter, index) => (
                    <button type="button" data-filter={filter.id} aria-pressed={index === 0 ? "true" : "false"}
                            class="pin-filter px-4 h-10 inline-flex items-center rounded-full border border-[var(--card-border)] text-sm font-extrabold text-[var(--ink)] hover:text-[var(--primary)] transition">
                        {filter.label}
                        <span class="ms-1.5 text-xs opacity-60">{filter.count}</span>
                    </button>
                ))}
            </div>
        </div>

        <!-- Masonry columns; pictures open in the lightbox (see Layout.astro), only the ones the filter shows -->
        <div class="columns-2 md:columns-3 gap-2 sm:gap-3 mb-4" dir="ltr" data-gallery>
            {pins.map((pin, index) => (
                <a href={pinImageUrl(pin.image)} target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer"
                   hidden={index >= PAGE_SIZE}
                   data-boards={pin.boards.map(slug).join(" ")}
                   class="pin-item block mb-2 sm:mb-3 break-inside-avoid overflow-hidden rounded-2xl border border-[var(--card-border)] bg-[var(--btn-regular-bg)] cursor-zoom-in">
                    <!-- no-referrer: Pinterest's CDN can refuse images requested from other sites -->
                    <img src={pinImageUrl(pin.image)} alt={pin.boards.map((board) => pinBoardLabels[board][lang]).join(", ")}
                         loading={index < 6 ? "eager" : "lazy"} decoding="async" referrerpolicy="no-referrer"
                         onload="this.parentElement.classList.add('loaded')" onerror="this.parentElement.remove()"
                         class="w-full h-auto hover:scale-[1.03] transition duration-300" />
                </a>
            ))}
        </div>

        <div class="flex justify-center mb-4">
            <button type="button" id="pins-more" class="btn-outline" hidden>
                <Icon name="material-symbols:expand-more-rounded" class="text-xl"></Icon>
                {t(I18nKey.loadMore)}
            </button>
        </div>
    </div>
</MainGridLayout>

<style>
    /* The "block" class would otherwise win over the hidden attribute and keep filtered pictures on screen */
    .pin-item[hidden] {
        display: none;
    }
    .pin-filter[aria-pressed="true"] {
        background: var(--primary-solid);
        color: var(--on-primary);
        border-color: transparent;
    }
    /* Placeholder until the picture arrives, so the columns don't jump while loading */
    .pin-item:not(.loaded) {
        min-height: 12rem;
        animation: pin-pulse 1.4s ease-in-out infinite;
    }
    .pin-item:not(.loaded) img {
        opacity: 0;
    }
    .pin-item img {
        transition: opacity 0.3s, transform 0.3s;
    }
    @keyframes pin-pulse {
        50% { opacity: 0.55; }
    }
    @media (prefers-reduced-motion: reduce) {
        .pin-item:not(.loaded) { animation: none; }
    }
</style>
