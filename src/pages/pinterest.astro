---
import { Icon } from "astro-icon/components";
import { pinBoards, pinImageUrl, pins } from "../data/pinterest";
import I18nKey from "../i18n/i18nKey";
import { toLang } from "../i18n/lang";
import { useTranslations } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";

const t = useTranslations(toLang(Astro.currentLocale));
const profileUrl = "https://www.pinterest.com/ali_umed/_created/";

// Board names can be Kurdish or Arabic, so the filters use plain ids like "b0"
const slug = (board: (typeof pinBoards)[number]) => `b${pinBoards.indexOf(board)}`;
const filters = [
	{ id: "all", label: t(I18nKey.filterAll), count: pins.length },
	...pinBoards.map((board) => ({
		id: slug(board),
		label: board,
		count: pins.filter((pin) => pin.boards.includes(board)).length,
	})),
];

// CSS-only filter, like the projects page: the checked radio hides pins from other boards
const filterCss = filters
	.slice(1)
	.map(
		({ id }) =>
			`.pins:has(#pin-filter-${id}:checked) label[data-filter="${id}"]{background:var(--primary-solid);color:var(--on-primary)}` +
			`.pins:has(#pin-filter-${id}:checked) .pin-item:not([data-boards~="${id}"]){display:none}`,
	)
	.join("");
---

<MainGridLayout title={t(I18nKey.pinterest)} description={t(I18nKey.pinterestDescription)}>
    <Fragment set:html={`<style>${filterCss}</style>`} />
    <div class="pins">
        {filters.map((filter, index) => (
            <input type="radio" name="pin-filter" id={`pin-filter-${filter.id}`} class="sr-only" checked={index === 0} />
        ))}

        <div class="card-base onload-animation p-3 mb-4">
            <div class="flex flex-wrap items-center justify-between gap-3 mb-3 ps-2">
                <div class="flex items-center gap-3 min-w-0">
                    <Icon name="fa6-brands:pinterest" class="text-2xl text-[#e60023] shrink-0"></Icon>
                    <div class="font-extrabold text-[var(--ink)]">{t(I18nKey.pinterestDescription)}</div>
                </div>
                <a href={profileUrl} target="_blank" rel="me noopener" class="btn-outline">
                    {t(I18nKey.openOnPinterest)}
                    <Icon name="fa6-solid:arrow-up-right-from-square" class="text-xs"></Icon>
                </a>
            </div>
            <div class="filter-tabs flex flex-wrap gap-1">
                {filters.map((filter) => (
                    <label for={`pin-filter-${filter.id}`} data-filter={filter.id}
                           class="cursor-pointer select-none px-4 h-10 inline-flex items-center rounded-full border border-[var(--card-border)] text-sm font-extrabold text-[var(--ink)] hover:text-[var(--primary)] transition">
                        {filter.label}
                        <span class="ms-1.5 text-xs opacity-60">{filter.count}</span>
                    </label>
                ))}
            </div>
        </div>

        <div class="columns-2 md:columns-3 gap-2 sm:gap-3 mb-4" dir="ltr">
            {pins.map((pin, index) => (
                <div class="pin-item mb-2 sm:mb-3 break-inside-avoid flex justify-center" data-boards={pin.boards.map(slug).join(" ")}>
                    <a href={pinImageUrl(pin.image)} target="_blank" rel="noopener noreferrer" referrerpolicy="no-referrer"
                       class="block w-full overflow-hidden rounded-2xl border border-[var(--card-border)] bg-[var(--btn-regular-bg)] active:scale-[0.98] transition">
                        <!-- no-referrer: Pinterest's CDN can refuse images requested from other sites -->
                        <img src={pinImageUrl(pin.image)} alt={pin.boards.join(", ")} loading={index < 6 ? "eager" : "lazy"}
                             decoding="async" referrerpolicy="no-referrer"
                             class="w-full h-auto hover:scale-[1.03] transition duration-300" />
                    </a>
                </div>
            ))}
        </div>
    </div>
</MainGridLayout>

<style>
    .pins:has(#pin-filter-all:checked) label[data-filter="all"] {
        background: var(--primary-solid);
        color: var(--on-primary);
    }
    .pins:has(input:focus-visible) .filter-tabs {
        outline: 2px solid var(--primary);
        outline-offset: 2px;
        border-radius: 1rem;
    }
</style>
