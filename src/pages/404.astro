---
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { toLang } from "../i18n/lang";
import { useTranslations } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { localeUrl } from "../utils/url-utils";

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
---

<MainGridLayout title={t(I18nKey.notFoundTitle)} description={t(I18nKey.notFoundHeading)}>
    <section class="card-base onload-animation p-8 md:p-12 mb-4 flex flex-col items-center text-center">
        <span class="chip h-8 px-3 text-xs mb-6">
            <Icon name="material-symbols:link-off-rounded" class="text-sm"></Icon>
            {t(I18nKey.notFoundChip)}
        </span>
        <div class="font-black tracking-tighter leading-none text-[7rem] md:text-[10rem] text-[var(--primary)]">404</div>
        <h1 class="font-black tracking-tight text-3xl md:text-4xl text-[var(--ink)] mt-4">{t(I18nKey.notFoundHeading)}</h1>
        <p class="text-base md:text-lg font-medium text-75 mt-3 max-w-md">
            {t(I18nKey.notFoundBody)}
        </p>
        <div class="flex flex-wrap justify-center gap-3 mt-8">
            <a href={localeUrl("/", lang)} class="btn-bold">
                <Icon name="material-symbols:home-outline-rounded" class="text-xl"></Icon>
                {t(I18nKey.goHome)}
            </a>
            <a href={localeUrl("/projects/", lang)} class="btn-outline">{t(I18nKey.seeProjects)}</a>
            <a href={localeUrl("/blogs/", lang)} class="btn-outline">{t(I18nKey.readTheBlog)}</a>
        </div>
    </section>
</MainGridLayout>
