---
import ProjectCard from "../components/ProjectCard.astro";
import I18nKey from "../i18n/i18nKey";
import { toLang } from "../i18n/lang";
import { useTranslations } from "../i18n/translation";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";

const t = useTranslations(toLang(Astro.currentLocale));

const allPosts = await getSortedPosts();

// Filter to only show projects
const projectPosts = allPosts.filter(
	(post) => post.data.category && typeof post.data.category === "string",
);

const filters = [
	{ id: "all", label: t(I18nKey.filterAll), category: null },
	{
		id: "mobile",
		label: t(I18nKey.mobileApps),
		category: "Mobile Application",
	},
	{ id: "web", label: t(I18nKey.websites), category: "Website" },
].map((filter) => ({
	...filter,
	count: filter.category
		? projectPosts.filter((post) => post.data.category === filter.category)
				.length
		: projectPosts.length,
}));

// Animation variables
let delay = 0;
const interval = 40;
---

<MainGridLayout title={t(I18nKey.projects)} description={t(I18nKey.projectsDescription)}>
    <div class="projects">
        <!-- CSS-only filter: the checked radio hides the other categories -->
        <input type="radio" name="project-filter" id="filter-all" class="sr-only" checked />
        <input type="radio" name="project-filter" id="filter-mobile" class="sr-only" />
        <input type="radio" name="project-filter" id="filter-web" class="sr-only" />

        <div class="card-base onload-animation flex flex-wrap items-center justify-between gap-3 p-3 mb-4">
            <div class="filter-tabs flex gap-1 p-1 rounded-full border border-[var(--card-border)]">
                {filters.map((filter) => (
                    <label for={`filter-${filter.id}`} data-filter={filter.id}
                           class="cursor-pointer select-none px-4 h-10 inline-flex items-center rounded-full text-sm font-extrabold text-[var(--ink)] hover:text-[var(--primary)] transition">
                        {filter.label}
                        <span class="ms-1.5 text-xs opacity-60">{filter.count}</span>
                    </label>
                ))}
            </div>
            <div class="text-sm font-bold text-50 px-2 hidden sm:block">{t(I18nKey.projectsHint)}</div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-4">
            {projectPosts.map((post) => (
                <div class="project-item" data-category={post.data.category === "Mobile Application" ? "mobile" : "web"}>
                    <ProjectCard
                        entry={post}
                        class="onload-animation"
                        style={`animation-delay: calc(var(--content-delay) + ${delay++ * interval}ms);`}
                    />
                </div>
            ))}
        </div>
    </div>
</MainGridLayout>

<style>
    .projects:has(#filter-all:checked) label[data-filter="all"],
    .projects:has(#filter-mobile:checked) label[data-filter="mobile"],
    .projects:has(#filter-web:checked) label[data-filter="web"] {
        background: var(--primary-solid);
        color: var(--on-primary);
    }
    .projects:has(#filter-mobile:checked) .project-item:not([data-category="mobile"]),
    .projects:has(#filter-web:checked) .project-item:not([data-category="web"]) {
        display: none;
    }
    .projects:has(input:focus-visible) .filter-tabs {
        outline: 2px solid var(--primary);
        outline-offset: 2px;
    }
</style>
