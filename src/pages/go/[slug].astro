---
// /go/<project>/: the address behind each app's QR code. It opens the right store for the phone
// that scanned it (App Store on iPhone/iPad, Google Play on Android) and offers both links otherwise.
import { getCollection } from "astro:content";
import { url } from "../../utils/url-utils";

export async function getStaticPaths() {
	const posts = await getCollection("posts", ({ data }) => !data.draft);
	return posts
		.filter((post) => post.data.appStore || post.data.playStore)
		.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const { appStore, playStore, icon, title } = post.data;
const name = title.includes(" - ") ? title.slice(0, title.indexOf(" - ")) : title;
const fallback = new URL(`/posts/${post.slug}/`, Astro.site).href;
---
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{name}</title>
    <script is:inline define:vars={{ appStore, playStore, fallback }}>
        const ua = navigator.userAgent || "";
        const ios = /iPhone|iPad|iPod/i.test(ua) || (/Macintosh/.test(ua) && navigator.maxTouchPoints > 1);
        const android = /Android/i.test(ua);
        const target = (ios && appStore) || (android && playStore) || (!ios && !android ? null : appStore || playStore || fallback);
        if (target) location.replace(target);
    </script>
    <!-- is:inline keeps these styles on this page only; bundled, the body rules would reach every page -->
    <style is:inline>
        body { margin: 0; min-height: 100vh; display: grid; place-items: center; font-family: system-ui, sans-serif; background: #f7f3ef; color: #1c1917; }
        main { text-align: center; padding: 24px; }
        img { width: 88px; height: 88px; border-radius: 22.5%; }
        h1 { font-size: 22px; margin: 16px 0 20px; }
        a { display: block; margin: 10px auto; max-width: 240px; padding: 12px 16px; border-radius: 14px; border: 1px solid #d6d3d1; color: inherit; text-decoration: none; font-weight: 700; }
        a.primary { background: #ea580c; border-color: #ea580c; color: #fff; }
        @media (prefers-color-scheme: dark) { body { background: #141210; color: #f5f5f4; } a { border-color: #44403c; } }
    </style>
</head>
<body>
    <main>
        {icon && <img src={url(icon)} alt="" />}
        <h1>{name}</h1>
        {appStore && <a class="primary" href={appStore}>App Store</a>}
        {playStore && <a class:list={[{ primary: !appStore }]} href={playStore}>Google Play</a>}
        <a href={fallback}>ali-umed.netlify.app</a>
    </main>
</body>
</html>
