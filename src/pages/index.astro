---
import { getCollection, getEntry, render } from "astro:content";
import HomeIntro from "@/components/HomeIntro.astro";
import PhoneShowcase from "@/components/PhoneShowcase.astro";
import ServiceCards from "@/components/ServiceCards.astro";
import { siteConfig } from "@/config";
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { getSortedPosts } from "@/utils/content-utils";

import "@/styles/main.css";
import "@/styles/markdown.css";

const homeEntry = await getEntry("spec", "home");
if (!homeEntry) {
	throw new Error("Home page content not found");
}

const blogs = await getCollection("blogs");
const sortedProjects = await getSortedPosts();

const totalProjects = sortedProjects.filter(
	(post) => post.data.category === "Mobile Application",
).length;
const totalBlogs = blogs.length;
const totalWebsites = sortedProjects.filter(
	(post) => post.data.category === "Website",
).length;

// home.md is currently all commented out; skip its card until it has content
const hasHomeContent =
	(homeEntry.body ?? "").replace(/<!--[\s\S]*?-->/g, "").trim() !== "";

const { Content } = await render(homeEntry);
const banner = siteConfig.banner.enable ? siteConfig.banner.src : undefined;
---

<MainGridLayout title="Home" description="Welcome to my portfolio" {banner}>
  <HomeIntro class="mb-12" />
  <div class="space-y-12">
    <ServiceCards 
      totalProjects={totalProjects}
      totalBlogs={totalBlogs}
      totalWebsites={totalWebsites}
    />
    
    <PhoneShowcase projects={sortedProjects} />

    {hasHomeContent && (
      <div class="card-base p-6 md:p-8">
        <article class="prose dark:prose-invert max-w-none">
          <Content />
        </article>
      </div>
    )}
  </div>
</MainGridLayout>