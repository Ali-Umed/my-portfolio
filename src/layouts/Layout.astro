const bannerEnabled = !!document.getElementById('banner-wrapper')

function setClickOutsideToClose(panel: string, ignores: string[]) {
	document.addEventListener("click", event => {
		let panelDom = document.getElementById(panel);
		let tDom = event.target;
		if (!(tDom instanceof Node)) return;		// Ensure the event target is an HTML Node
		for (let ig of ignores) {
			let ie = document.getElementById(ig)
			if (ie == tDom || (ie?.contains(tDom))) {
				return;
			}
		}
		panelDom!.classList.add("float-panel-closed");
	});
}
setClickOutsideToClose("display-setting", ["display-setting", "display-settings-switch"])
setClickOutsideToClose("nav-menu-panel", ["nav-menu-panel", "nav-menu-switch"])
setClickOutsideToClose("search-panel", ["search-panel", "search-bar", "search-switch"])


function loadTheme() {
	const theme = getStoredTheme()
	setTheme(theme)
}

function loadHue() {
	setHue(getHue())
}

function initCustomScrollbar() {
	const bodyElement = document.querySelector('body');
	if (!bodyElement) return;
	OverlayScrollbars(
		// docs say that a initialization to the body element would affect native functionality like window.scrollTo
		// but just leave it here for now
		{
			target: bodyElement,
			cancel: {
				nativeScrollbarsOverlaid: true,    // don't initialize the overlay scrollbar if there is a native one
			}
		}, {
		scrollbars: {
			theme: 'scrollbar-base scrollbar-auto py-1',
			autoHide: 'move',
			autoHideDelay: 500,
			autoHideSuspend: false,
		},
	});

	const katexElements = document.querySelectorAll('.katex-display') as NodeListOf<HTMLElement>;

	const katexObserverOptions = {
		root: null,
		rootMargin: '100px',
		threshold: 0.1
	};

	const processKatexElement = (element: HTMLElement) => {
		if (!element.parentNode) return;
		if (element.hasAttribute('data-scrollbar-initialized')) return;

		const container = document.createElement('div');
		container.className = 'katex-display-container';
		container.setAttribute('aria-label', 'scrollable container for formulas');

		element.parentNode.insertBefore(container, element);
		container.appendChild(element);

		OverlayScrollbars(container, {
			scrollbars: {
				theme: 'scrollbar-base scrollbar-auto',
				autoHide: 'leave',
				autoHideDelay: 500,
				autoHideSuspend: false
			}
		});

		element.setAttribute('data-scrollbar-initialized', 'true');
	};

	const katexObserver = new IntersectionObserver((entries, observer) => {
		entries.forEach(entry => {
			if (entry.isIntersecting) {
			processKatexElement(entry.target as HTMLElement);
			observer.unobserve(entry.target);
			}
		});
	}, katexObserverOptions);

	katexElements.forEach(element => {
		katexObserver.observe(element);
	});
}

function showBanner() {
	if (!siteConfig.banner.enable) return;

	const banner = document.getElementById('banner');
	if (!banner) {
		console.error('Banner element not found');
		return;
	}

	banner.classList.remove('opacity-0', 'scale-105');
}

function init() {
	// disableAnimation()()		// TODO
	loadTheme();
	loadHue();
	initCustomScrollbar();
	showBanner();
}

/* Load settings when entering the site */
init();

const setup = () => {
	// TODO: temp solution to change the height of the banner
/*
	window.swup.hooks.on('animation:out:start', () => {
		const path = window.location.pathname
		const body = document.querySelector('body')
		if (path[path.length - 1] === '/' && !body.classList.contains('is-home')) {
			body.classList.add('is-home')
		} else if (path[path.length - 1] !== '/' && body.classList.contains('is-home')) {
			body.classList.remove('is-home')
		}
	})
*/
	// Swup only swaps <main>, so the navbar and sidebar would keep the old language:
	// load links into the other language as a normal page instead
	const ignoreVisit = window.swup.options.ignoreVisit
	window.swup.options.ignoreVisit = (visitUrl: string, options?: {el?: Element, event?: Event}) =>
		ignoreVisit(visitUrl, options) ||
		getLangFromPath(new URL(visitUrl, window.location.href).pathname) !== getLangFromPath(window.location.pathname)

	window.swup.hooks.on('link:click', () => {
		// Remove the delay for the first time page load
		document.documentElement.style.setProperty('--content-delay', '0ms')

		// prevent elements from overlapping the navbar
		if (!bannerEnabled) {
			return
		}
		let threshold = window.innerHeight * (BANNER_HEIGHT / 100) - 72 - 16
		let navbar = document.getElementById('navbar-wrapper')
		if (!navbar || !document.body.classList.contains('lg:is-home')) {
			return
		}
		if (document.body.scrollTop >= threshold || document.documentElement.scrollTop >= threshold) {
			navbar.classList.add('navbar-hidden')
		}
	})
	window.swup.hooks.on('content:replace', initCustomScrollbar)
	window.swup.hooks.on('visit:start', (visit: {to: {url: string}}) => {
		// change banner height immediately when a link is clicked
		const bodyElement = document.querySelector('body')
		if (pathsEqual(visit.to.url, url('/'))) {
			bodyElement!.classList.add('lg:is-home');
		} else {
			bodyElement!.classList.remove('lg:is-home');
		}

		// increase the page height during page transition to prevent the scrolling animation from jumping
		const heightExtend = document.getElementById('page-height-extend')
		if (heightExtend) {
			heightExtend.classList.remove('hidden')
		}

		// Hide the TOC while scrolling back to top
		let toc = document.getElementById('toc-wrapper');
		if (toc) {
			toc.classList.add('toc-not-ready')
		}
	});
	window.swup.hooks.on('page:view', () => {
		// hide the temp high element when the transition is done
		const heightExtend = document.getElementById('page-height-extend')
		if (heightExtend) {
			heightExtend.classList.remove('hidden')
		}
	});
	window.swup.hooks.on('visit:end', (_visit: {to: {url: string}}) => {
		setTimeout(() => {
			const heightExtend = document.getElementById('page-height-extend')
			if (heightExtend) {
				heightExtend.classList.add('hidden')
			}

            // Just make the transition looks better
            const toc = document.getElementById('toc-wrapper');
            if (toc) {
                toc.classList.remove('toc-not-ready')
            }
        }, 200)
	});
}
if (window?.swup?.hooks) {
	setup()
} else {
	document.addEventListener('swup:enable', setup)
}

let backToTopBtn = document.getElementById('back-to-top-btn');
let toc = document.getElementById('toc-wrapper');
let navbar = document.getElementById('navbar-wrapper')
function scrollFunction() {
	let bannerHeight = window.innerHeight * (BANNER_HEIGHT / 100)

	if (backToTopBtn) {
		if (document.body.scrollTop > bannerHeight || document.documentElement.scrollTop > bannerHeight) {
			backToTopBtn.classList.remove('hide')
		} else {
			backToTopBtn.classList.add('hide')
		}
	}

	if (bannerEnabled && toc) {
		if (document.body.scrollTop > bannerHeight || document.documentElement.scrollTop > bannerHeight) {
			toc.classList.remove('toc-hide')
		} else {
			toc.classList.add('toc-hide')
		}
	}

	if (!bannerEnabled) return
	if (navbar) {
		const NAVBAR_HEIGHT = 72
		const MAIN_PANEL_EXCESS_HEIGHT = MAIN_PANEL_OVERLAPS_BANNER_HEIGHT * 16			// The height the main panel overlaps the banner

		let bannerHeight = BANNER_HEIGHT
		if (document.body.classList.contains('lg:is-home') && window.innerWidth >= 1024) {
			bannerHeight = BANNER_HEIGHT_HOME
		}
		let threshold = window.innerHeight * (bannerHeight / 100) - NAVBAR_HEIGHT - MAIN_PANEL_EXCESS_HEIGHT - 16
		if (document.body.scrollTop >= threshold || document.documentElement.scrollTop >= threshold) {
			navbar.classList.add('navbar-hidden')
		} else {
			navbar.classList.remove('navbar-hidden')
		}
	}
}
window.onscroll = scrollFunction

window.onresize = () => {
	// calculate the --banner-height-extend, which needs to be a multiple of 4 to avoid blurry text
	let offset = Math.floor(window.innerHeight * (BANNER_HEIGHT_EXTEND / 100));
	offset = offset - offset % 4;
	document.documentElement.style.setProperty('--banner-height-extend', `${offset}px`);
}

</script>

<script>
import PhotoSwipeLightbox from "photoswipe/lightbox"
import "photoswipe/style.css"

let lightbox: PhotoSwipeLightbox
let pswp = import("photoswipe")

function createPhotoSwipe() {
	lightbox = new PhotoSwipeLightbox({
		gallery: ".custom-md img, #post-cover img",
		pswpModule: () => pswp,
		closeSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M480-424 284-228q-11 11-28 11t-28-11q-11-11-11-28t11-28l196-196-196-196q-11-11-11-28t11-28q11-11 28-11t28 11l196 196 196-196q11-11 28-11t28 11q11 11 11 28t-11 28L536-480l196 196q11 11 11 28t-11 28q-11 11-28 11t-28-11L480-424Z"/></svg>',
		zoomSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M340-540h-40q-17 0-28.5-11.5T260-580q0-17 11.5-28.5T300-620h40v-40q0-17 11.5-28.5T380-700q17 0 28.5 11.5T420-660v40h40q17 0 28.5 11.5T500-580q0 17-11.5 28.5T460-540h-40v40q0 17-11.5 28.5T380-460q-17 0-28.5-11.5T340-500v-40Zm40 220q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l224 224q11 11 11 28t-11 28q-11 11-28 11t-28-11L532-372q-30 24-69 38t-83 14Zm0-80q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z"/></svg>',
		padding: { top: 20, bottom: 20, left: 20, right: 20 },
		wheelToZoom: true,
		arrowPrev: false,
		arrowNext: false,
		imageClickAction: 'close',
		tapAction: 'close',
		doubleTapAction: 'zoom',
	})

	lightbox.addFilter("domItemData", (itemData, element) => {
		if (element instanceof HTMLImageElement) {
			itemData.src = element.src

			itemData.w = Number(element.naturalWidth || window.innerWidth)
			itemData.h = Number(element.naturalHeight || window.innerHeight)

			itemData.msrc = element.src
		}

		return itemData
	})

	lightbox.init()
}

// Galleries ([data-gallery]): screenshots and Pinterest pictures open as one set, with arrows and swipe between them.
// Only the pictures shown right now are in the set, so a filtered Pinterest page only shows that board.
const galleryOptions = {
	padding: { top: 20, bottom: 20, left: 20, right: 20 },
	// Two-finger zoom on phones goes up to 4x; double tap zooms to 2x
	secondaryZoomLevel: 2,
	maxZoomLevel: 4,
	wheelToZoom: true,
	imageClickAction: "close" as const,
	tapAction: "close" as const,
	doubleTapAction: "zoom" as const,
	bgOpacity: 0.92,
}

// Average colour of a picture, darkened for a viewer background. Needs the image host to allow
// reading pixels (CORS); when it doesn't, the default background stays.
const colorCache = new Map<string, Promise<string | null>>()
function averageColor(src: string): Promise<string | null> {
	if (!colorCache.has(src)) {
		colorCache.set(src, new Promise((resolve) => {
			const img = new Image()
			img.crossOrigin = "anonymous"
			img.referrerPolicy = "no-referrer"
			img.onload = () => {
				try {
					const canvas = document.createElement("canvas")
					canvas.width = canvas.height = 8
					const ctx = canvas.getContext("2d")
					if (!ctx) return resolve(null)
					ctx.drawImage(img, 0, 0, 8, 8)
					const px = ctx.getImageData(0, 0, 8, 8).data
					let r = 0, g = 0, b = 0
					for (let i = 0; i < px.length; i += 4) { r += px[i]; g += px[i + 1]; b += px[i + 2] }
					const n = px.length / 4, k = 0.35
					resolve(`rgb(${Math.round((r / n) * k)}, ${Math.round((g / n) * k)}, ${Math.round((b / n) * k)})`)
				} catch {
					resolve(null)
				}
			}
			img.onerror = () => resolve(null)
			img.src = src
		}))
	}
	return colorCache.get(src) as Promise<string | null>
}

// Saves a picture. Pictures from other sites can only be saved when the site allows it (CORS);
// otherwise the picture opens in a new tab, where it can be saved from the browser.
async function downloadImage(src: string) {
	const name = src.split("/").pop()?.split("?")[0] || "picture.jpg"
	try {
		const res = await fetch(src, { referrerPolicy: "no-referrer" })
		if (!res.ok) throw new Error(String(res.status))
		const blob = URL.createObjectURL(await res.blob())
		const link = document.createElement("a")
		link.href = blob
		link.download = name
		document.body.appendChild(link)
		link.click()
		link.remove()
		setTimeout(() => URL.revokeObjectURL(blob), 1000)
	} catch {
		window.open(src, "_blank", "noopener,noreferrer")
	}
}

async function openGallery(gallery: HTMLElement, clicked: HTMLImageElement) {
	const order = (img: HTMLImageElement) => {
		const item = img.closest<HTMLElement>("[data-index]")
		return Number(item?.dataset.order ?? item?.dataset.index ?? 0)
	}
	const images = [...gallery.querySelectorAll<HTMLImageElement>("img")]
		.filter((img) => img.offsetParent !== null)
		.sort((a, b) => order(a) - order(b))
	const dataSource = images.map((img) => ({
		src: img.dataset.full || img.currentSrc || img.src,
		msrc: img.currentSrc || img.src,
		alt: img.alt,
		// Pictures still loading get a guessed portrait size, fixed once they arrive
		// Size of the picture shown: the full-size copy keeps the same shape, so scale up from the page copy
		w: img.dataset.full && img.naturalWidth ? 1320 : img.naturalWidth || 736,
		h: img.dataset.full && img.naturalWidth ? Math.round((1320 * img.naturalHeight) / img.naturalWidth) : img.naturalHeight || 1100,
		element: img,
	}))
	const { default: PhotoSwipe } = await pswp
	const viewer = new PhotoSwipe({
		...galleryOptions,
		dataSource,
		index: Math.max(0, images.indexOf(clicked)),
		closeSVG: lightbox?.options.closeSVG,
		zoomSVG: lightbox?.options.zoomSVG,
	})
	// Same as the page's pictures: Pinterest's CDN can refuse images requested with another site's address
	// Download button in the top bar
	viewer.on("uiRegister", () => {
		viewer.ui?.registerElement({
			name: "download",
			order: 8,
			isButton: true,
			title: "Download",
			html: '<svg xmlns="http://www.w3.org/2000/svg" height="24" viewBox="0 -960 960 960" width="24" fill="#fff"><path d="M480-337q-8 0-15-2.5t-13-8.5L308-492q-12-12-11.5-28t11.5-28q12-12 28.5-12.5T365-549l75 75v-286q0-17 11.5-28.5T480-800q17 0 28.5 11.5T520-760v286l75-75q12-12 28.5-11.5T652-548q11 12 11.5 28T652-492L508-348q-6 6-13 8.5t-15 2.5ZM240-160q-33 0-56.5-23.5T160-240v-80q0-17 11.5-28.5T200-360q17 0 28.5 11.5T240-320v80h480v-80q0-17 11.5-28.5T760-360q17 0 28.5 11.5T800-320v80q0 33-23.5 56.5T720-160H240Z"/></svg>',
			onClick: () => {
				const src = viewer.currSlide?.data.src
				if (src) downloadImage(src)
			},
		})
	})
	viewer.on("contentLoadImage", ({ content }) => {
		if (content.element instanceof HTMLImageElement) content.element.referrerPolicy = "no-referrer"
	})
	// Tint the background with the picture's own colour
	const tint = () => {
		const src = viewer.currSlide?.data.src
		const bg = viewer.element?.querySelector<HTMLElement>(".pswp__bg")
		if (!src || !bg) return
		averageColor(src).then((color) => {
			if (color && viewer.currSlide?.data.src === src) bg.style.background = color
		})
	}
	viewer.on("change", tint)
	viewer.on("afterInit", tint)
	viewer.on("loadComplete", ({ content, slide }) => {
		const img = content.element as HTMLImageElement | undefined
		const data = content.data as { w?: number; h?: number }
		if (img?.naturalWidth && (img.naturalWidth !== data.w || img.naturalHeight !== data.h)) {
			data.w = img.naturalWidth
			data.h = img.naturalHeight
			viewer.refreshSlideContent(slide.index)
		}
	})
	viewer.init()
}

// Reading progress bar: how far the article has been scrolled past
function updateReadingProgress() {
	const bar = document.getElementById("reading-progress")
	const article = document.querySelector<HTMLElement>("[data-reading-article]")
	if (!bar) return
	if (!article) {
		bar.style.opacity = "0"
		return
	}
	const rect = article.getBoundingClientRect()
	const total = rect.height - window.innerHeight
	const progress = total > 0 ? Math.min(1, Math.max(0, -rect.top / total)) : 1
	bar.style.opacity = progress > 0 ? "1" : "0"
	bar.style.transform = `scaleX(${progress})`
}
window.addEventListener("scroll", updateReadingProgress, { passive: true })
window.addEventListener("resize", updateReadingProgress, { passive: true })

// Small burst of dots from an element, used when a link is copied
function burst(el: HTMLElement) {
	if (matchMedia("(prefers-reduced-motion: reduce)").matches) return
	const rect = el.getBoundingClientRect()
	const colors = ["var(--primary)", "#f59e0b", "#10b981", "#3b82f6", "#ec4899"]
	for (let i = 0; i < 14; i++) {
		const dot = document.createElement("span")
		const angle = (Math.PI * 2 * i) / 14 + Math.random() * 0.4
		const distance = 28 + Math.random() * 26
		dot.className = "burst-dot"
		dot.style.left = `${rect.left + rect.width / 2}px`
		dot.style.top = `${rect.top + rect.height / 2}px`
		dot.style.background = colors[i % colors.length]
		dot.style.setProperty("--dx", `${Math.cos(angle) * distance}px`)
		dot.style.setProperty("--dy", `${Math.sin(angle) * distance}px`)
		document.body.appendChild(dot)
		setTimeout(() => dot.remove(), 700)
	}
}

// "Copy link" buttons (CopyLinkButton.astro): copy the page address and say so for two seconds
document.addEventListener("click", async (event) => {
	const button = (event.target as HTMLElement | null)?.closest?.<HTMLElement>("[data-copy-link]")
	if (!button) return
	const href = window.location.href.split("#")[0]
	try {
		await navigator.clipboard.writeText(href)
	} catch {
		window.prompt("", href)
		return
	}
	const label = button.querySelector(".copy-label")
	const original = label?.textContent ?? ""
	if (label) label.textContent = button.dataset.copiedLabel ?? original
	button.querySelector(".copy-icon")?.classList.add("hidden")
	button.querySelector(".done-icon")?.classList.remove("hidden")
	burst(button)
	setTimeout(() => {
		if (label) label.textContent = original
		button.querySelector(".copy-icon")?.classList.remove("hidden")
		button.querySelector(".done-icon")?.classList.add("hidden")
	}, 2000)
})

// Sections fade in as they scroll into view. Only cards below the first screen are hidden first,
// so nothing that is already visible flashes, and reduced-motion users see everything at once.
let revealObserver: IntersectionObserver | undefined
function setupReveal() {
	revealObserver?.disconnect()
	if (!("IntersectionObserver" in window) || matchMedia("(prefers-reduced-motion: reduce)").matches) return
	revealObserver = new IntersectionObserver((entries) => {
		for (const entry of entries) {
			if (!entry.isIntersecting) continue
			entry.target.classList.add("revealed")
			revealObserver?.unobserve(entry.target)
		}
	}, { rootMargin: "0px 0px -8% 0px" })
	const candidates = document.querySelectorAll<HTMLElement>(
		"#swup-container .card-base, #swup-container section, #swup-container .pin-item, #swup-container .project-item, footer.card-base",
	)
	for (const el of candidates) {
		if (el.parentElement?.closest(".reveal")) continue
		if (el.getBoundingClientRect().top < window.innerHeight) continue
		el.classList.add("reveal")
		revealObserver.observe(el)
	}
}
// Runs on the first load and after every swup page change. Page scripts don't run again when swup
// swaps in a page, so page behaviour that must work after navigation is set up from here.
function onEveryPage(fn: () => void) {
	fn()
	const hook = () => window.swup.hooks.on("page:view", fn)
	if (window.swup) hook()
	else document.addEventListener("swup:enable", hook)
}
// Filters and "load more": the first pictures of the chosen board show, more come in at the end of the list
let observer: IntersectionObserver | undefined;

function setupPins() {
    const root = document.getElementById("pins");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "true";

    const pageSize = Number(root.dataset.pageSize);
    const items = [...root.querySelectorAll<HTMLElement>(".pin-item")];
    const buttons = [...root.querySelectorAll<HTMLButtonElement>(".pin-filter")];
    const more = root.querySelector<HTMLButtonElement>("#pins-more");
    let filter = "all";
    let limit = pageSize;

    const grid = root.querySelector<HTMLElement>("#pin-grid");
    const columnCount = () => (window.innerWidth >= 768 ? 3 : 2);
    let columns: HTMLElement[] = [];

    // Picture n goes to column n % count, so the first ones are along the top row and
    // a picture never moves when the ones above it finish loading or more are added
    const render = () => {
        const matching = items.filter((item) => item.isConnected && (filter === "all" || item.dataset.boards?.split(" ").includes(filter)));
        const shown = matching.slice(0, limit);
        if (grid && columns.length !== columnCount()) {
            for (const column of columns) column.remove();
            columns = Array.from({ length: columnCount() }, () => {
                const column = document.createElement("div");
                column.className = "pin-column";
                grid.appendChild(column);
                return column;
            });
        }
        for (const item of items) item.hidden = true;
        shown.forEach((item, index) => {
            item.dataset.order = String(index);
            // Appending in order keeps the pictures already placed where they are
            columns[index % columns.length]?.appendChild(item);
            item.hidden = false;
        });
        if (more) more.hidden = matching.length <= limit;
    };
    let resizeTimer: number | undefined;
    window.addEventListener("resize", () => {
        clearTimeout(resizeTimer);
        resizeTimer = window.setTimeout(() => {
            if (root.isConnected && columns.length !== columnCount()) render();
        }, 150);
    });

    for (const button of buttons) {
        button.addEventListener("click", () => {
            filter = button.dataset.filter ?? "all";
            limit = pageSize;
            for (const other of buttons) other.setAttribute("aria-pressed", String(other === button));
            render();
        });
    }

    more?.addEventListener("click", () => {
        limit += pageSize;
        render();
    });

    // Shuffle: a new random order, starting again from the top
    root.querySelector("#pins-shuffle")?.addEventListener("click", () => {
        for (let i = items.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [items[i], items[j]] = [items[j], items[i]];
        }
        limit = pageSize;
        for (const column of columns) column.replaceChildren();
        render();
    });

    // Load the next pictures on their own when the button scrolls into view
    observer?.disconnect();
    if (more && "IntersectionObserver" in window) {
        observer = new IntersectionObserver((entries) => {
            if (entries.some((entry) => entry.isIntersecting) && !more.hidden) more.click();
        }, { rootMargin: "200px" });
        observer.observe(more);
    }

    render();
}

// Navbar: smaller and see-through once the page is scrolled, with a pill sliding under the current tab
function updateNavbar() {
	document.getElementById("navbar")?.classList.toggle("scrolled", window.scrollY > 24)
}
function moveNavPill() {
	const pill = document.getElementById("nav-pill")
	const links = [...document.querySelectorAll<HTMLAnchorElement>("#nav-links a[data-nav-path]")]
	if (!pill) return
	const path = window.location.pathname
	const active = links
		.filter((link) => {
			const target = link.dataset.navPath ?? ""
			return target === path || (target.split("/").filter(Boolean).length > (target.startsWith("/ku/") ? 1 : 0) && path.startsWith(target))
		})
		.sort((a, b) => (b.dataset.navPath?.length ?? 0) - (a.dataset.navPath?.length ?? 0))[0]
	for (const link of links) link.classList.toggle("nav-active", link === active)
	if (!active) {
		pill.style.opacity = "0"
		return
	}
	pill.style.opacity = "1"
	pill.style.width = `${active.offsetWidth}px`
	pill.style.transform = `translateX(${active.offsetLeft}px)`
}
window.addEventListener("scroll", updateNavbar, { passive: true })
window.addEventListener("resize", moveNavPill, { passive: true })
document.fonts?.ready.then(moveNavPill)

// Back-to-top ring: fills as the page is scrolled
function updateScrollRing() {
	const ring = document.querySelector<SVGCircleElement>("#back-to-top-ring circle")
	if (!ring) return
	const max = document.documentElement.scrollHeight - window.innerHeight
	const progress = max > 0 ? Math.min(1, window.scrollY / max) : 0
	ring.style.strokeDashoffset = String(100 - progress * 100)
}
window.addEventListener("scroll", updateScrollRing, { passive: true })

// Numbers count up from 0 when they come into view ([data-count-to], with an optional data-count-suffix)
function setupCountUp() {
	const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches
	for (const el of document.querySelectorAll<HTMLElement>("[data-count-to]")) {
		const target = Number(el.dataset.countTo)
		const suffix = el.dataset.countSuffix ?? ""
		if (reduce || !("IntersectionObserver" in window)) continue
		el.textContent = `0${suffix}`
		const observer = new IntersectionObserver((entries) => {
			if (!entries.some((entry) => entry.isIntersecting)) return
			observer.disconnect()
			const start = performance.now()
			const step = (now: number) => {
				const t = Math.min(1, (now - start) / 1200)
				const eased = 1 - (1 - t) ** 3
				el.textContent = `${Math.round(target * eased)}${suffix}`
				if (t < 1) requestAnimationFrame(step)
			}
			requestAnimationFrame(step)
		})
		observer.observe(el)
	}
}

// Shimmering placeholder behind pictures until they arrive (Pinterest pictures have their own)
function setupImageSkeletons() {
	for (const img of document.querySelectorAll<HTMLImageElement>("#swup-container img")) {
		if (img.complete || img.closest(".pin-item")) continue
		img.classList.add("img-loading")
		const done = () => img.classList.remove("img-loading")
		img.addEventListener("load", done, { once: true })
		img.addEventListener("error", done, { once: true })
	}
}

// GitHub contribution calendar on the About page ([data-github-calendar]), from a public API; hidden if it can't load
async function setupGithubCalendar() {
	const box = document.querySelector<HTMLElement>("[data-github-calendar]")
	if (!box || box.dataset.ready) return
	box.dataset.ready = "true"
	try {
		const res = await fetch(`https://github-contributions-api.jogruber.de/v4/${box.dataset.githubCalendar}?y=last`)
		if (!res.ok) throw new Error(String(res.status))
		const data: { total: Record<string, number>; contributions: { date: string; count: number; level: number }[] } = await res.json()
		const days = data.contributions
		const grid = box.querySelector<HTMLElement>(".gh-grid")
		const total = box.querySelector<HTMLElement>(".gh-total")
		if (!grid || !days.length) throw new Error("empty")
		// Weeks are columns, starting on Sunday like GitHub
		const pad = new Date(days[0].date).getDay()
		const cells = [...Array(pad).fill(null), ...days]
		grid.innerHTML = cells
			.map((day) => day
				? `<span class="gh-day" data-level="${day.level}" title="${day.count} · ${day.date}"></span>`
				: `<span class="gh-day gh-empty"></span>`)
			.join("")
		const count = Object.values(data.total).reduce((a, b) => a + b, 0)
		if (total) total.textContent = (total.dataset.template ?? "{count}").replace("{count}", String(count))
		box.hidden = false
		grid.scrollLeft = grid.scrollWidth
	} catch {
		box.hidden = true
	}
}

// Home-page phone ([data-phone]): tilts with the visitor's phone or the mouse, and holding an app
// makes all icons wiggle (letting go opens the app, like a normal tap)
function setupPhone() {
	const phone = document.querySelector<HTMLElement>("[data-phone]")
	if (!phone || phone.dataset.ready) return
	phone.dataset.ready = "true"
	const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches
	const tilt = (x: number, y: number) => {
		if (!phone.isConnected) return
		phone.style.transform = `perspective(1200px) rotateY(${x.toFixed(2)}deg) rotateX(${y.toFixed(2)}deg)`
	}
	if (!reduce) {
		phone.addEventListener("pointermove", (event) => {
			if (event.pointerType !== "mouse") return
			const rect = phone.getBoundingClientRect()
			tilt(((event.clientX - rect.left) / rect.width - 0.5) * 12, -((event.clientY - rect.top) / rect.height - 0.5) * 8)
		})
		phone.addEventListener("pointerleave", () => tilt(0, 0))
		// Phones: follow the device's own tilt (Android; iPhones only allow this after a permission prompt, so they skip it)
		let base: number | null = null
		window.addEventListener("deviceorientation", (event) => {
			if (event.gamma == null || event.beta == null || !phone.isConnected) return
			base ??= event.beta
			const clamp = (v: number) => Math.max(-10, Math.min(10, v))
			tilt(clamp(event.gamma / 3), clamp(-(event.beta - base) / 4))
		})
	}
	// Live clock, 24-hour like the picture had
	const clock = phone.querySelector<HTMLElement>("[data-phone-clock]")
	const tick = () => {
		if (!clock?.isConnected) return
		const now = new Date()
		clock.textContent = `${String(now.getHours()).padStart(2, "0")}:${String(now.getMinutes()).padStart(2, "0")}`
		window.setTimeout(tick, (60 - now.getSeconds()) * 1000)
	}
	tick()
	let holdTimer: number | undefined
	let stopTimer: number | undefined
	phone.addEventListener("pointerdown", (event) => {
		if (!(event.target as HTMLElement).closest(".app-hotspot")) return
		clearTimeout(holdTimer)
		holdTimer = window.setTimeout(() => {
			phone.classList.add("jiggle")
			navigator.vibrate?.(15)
		}, 450)
	})
	const release = () => {
		clearTimeout(holdTimer)
		clearTimeout(stopTimer)
		stopTimer = window.setTimeout(() => phone.classList.remove("jiggle"), 1200)
	}
	phone.addEventListener("pointerup", release)
	phone.addEventListener("pointercancel", release)
	phone.addEventListener("contextmenu", (event) => event.preventDefault())
}

// Project pages: arrow keys and side swipes go to the project card on that side ([data-project-nav])
function goToProject(side: "left" | "right") {
	const cards = [...document.querySelectorAll<HTMLAnchorElement>("[data-project-nav]")]
	if (cards.length === 0) return
	const centre = window.innerWidth / 2
	const card = cards.find((el) => {
		const rect = el.getBoundingClientRect()
		const middle = rect.left + rect.width / 2
		return side === "left" ? middle < centre : middle >= centre
	})
	card?.click()
}
document.addEventListener("keydown", (event) => {
	if (event.key !== "ArrowLeft" && event.key !== "ArrowRight") return
	if (event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return
	const target = event.target as HTMLElement | null
	if (target?.closest("input, textarea, select, [contenteditable]") || document.querySelector(".pswp--open")) return
	goToProject(event.key === "ArrowLeft" ? "left" : "right")
})
let swipeStart: { x: number; y: number; t: number } | null = null
document.addEventListener("touchstart", (event) => {
	const target = event.target as HTMLElement | null
	// Not on things that scroll sideways themselves
	if (event.touches.length !== 1 || target?.closest("#screenshots, .pswp, .gh-grid, input, [data-phone]")) {
		swipeStart = null
		return
	}
	swipeStart = { x: event.touches[0].clientX, y: event.touches[0].clientY, t: Date.now() }
}, { passive: true })
document.addEventListener("touchend", (event) => {
	if (!swipeStart || !document.querySelector("[data-project-nav]")) return
	const dx = event.changedTouches[0].clientX - swipeStart.x
	const dy = event.changedTouches[0].clientY - swipeStart.y
	const quick = Date.now() - swipeStart.t < 600
	swipeStart = null
	// A finger moving left brings in the card on the right, like turning a page
	if (quick && Math.abs(dx) > 90 && Math.abs(dx) > Math.abs(dy) * 2) goToProject(dx < 0 ? "right" : "left")
}, { passive: true })

// Soft click sounds, when turned on in display settings; made with the Web Audio API, no sound files
let audio: AudioContext | undefined
document.addEventListener("pointerdown", (event) => {
	let on = false
	try {
		on = localStorage.getItem("sounds") === "on"
	} catch {}
	if (!on || !(event.target as HTMLElement | null)?.closest?.("a, button, label, [role='button'], [role='switch']")) return
	audio ??= new AudioContext()
	const now = audio.currentTime
	const osc = audio.createOscillator()
	const gain = audio.createGain()
	osc.type = "sine"
	osc.frequency.setValueAtTime(880, now)
	osc.frequency.exponentialRampToValueAtTime(440, now + 0.06)
	gain.gain.setValueAtTime(0.06, now)
	gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.08)
	osc.connect(gain).connect(audio.destination)
	osc.start(now)
	osc.stop(now + 0.09)
}, { passive: true })

// The home icon in the navbar bounces when arriving on the home page
function bounceHomeIcon() {
	const icon = document.querySelector<HTMLElement>("#navbar .home-icon")
	const path = window.location.pathname
	if (!icon || (path !== "/" && path !== "/ku/")) return
	icon.classList.remove("home-bounce")
	void icon.offsetWidth
	icon.classList.add("home-bounce")
}

// Secret: ↑ ↑ ↓ ↓ ← → ← → B A turns on a retro pixel look (the same again turns it off)
const konami = ["ArrowUp", "ArrowUp", "ArrowDown", "ArrowDown", "ArrowLeft", "ArrowRight", "ArrowLeft", "ArrowRight", "b", "a"]
let konamiStep = 0
document.addEventListener("keydown", (event) => {
	const key = event.key.length === 1 ? event.key.toLowerCase() : event.key
	konamiStep = key === konami[konamiStep] ? konamiStep + 1 : key === konami[0] ? 1 : 0
	if (konamiStep < konami.length) return
	konamiStep = 0
	const on = document.documentElement.classList.toggle("retro")
	const toast = document.createElement("div")
	toast.className = "retro-toast"
	toast.textContent = on ? "★ RETRO MODE ★" : "Back to normal"
	document.body.appendChild(toast)
	setTimeout(() => toast.remove(), 2200)
})

// A little cat walks along the bottom of the screen now and then (not with reduced motion)
function walkCat() {
	if (document.getElementById("walking-cat")) return
	// While the tab is hidden, wait and try again instead of walking unseen
	if (document.hidden) {
		window.setTimeout(walkCat, CAT_PAUSE)
		return
	}
	const cat = document.createElement("div")
	cat.id = "walking-cat"
	cat.setAttribute("aria-hidden", "true")
	const rtl = document.documentElement.dir === "rtl"
	if (rtl) cat.classList.add("from-right")
	cat.innerHTML = `<svg viewBox="0 0 64 40" width="64" height="40">
		<g class="cat-body" fill="currentColor">
			<path class="cat-tail" d="M8 20 q-8 -6 -4 -16" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
			<ellipse cx="26" cy="22" rx="18" ry="9"/>
			<circle cx="46" cy="15" r="8"/>
			<path d="M40 10 l2 -8 l5 6 z M47 8 l5 -6 l1 8 z"/>
			<rect class="cat-leg leg-a" x="13" y="27" width="4" height="11" rx="2"/>
			<rect class="cat-leg leg-b" x="20" y="27" width="4" height="11" rx="2"/>
			<rect class="cat-leg leg-a" x="31" y="27" width="4" height="11" rx="2"/>
			<rect class="cat-leg leg-b" x="38" y="27" width="4" height="11" rx="2"/>
		</g>
		<circle cx="49" cy="14" r="1.4" fill="var(--page-bg, #fff)"/>
	</svg>`
	document.body.appendChild(cat)
	cat.addEventListener("animationend", (event) => {
		if (event.target !== cat) return
		cat.remove()
		window.setTimeout(walkCat, CAT_PAUSE)
	})
}
// First walk 10 seconds after opening the site, then again 10 seconds after each walk ends
const CAT_PAUSE = 10000
if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
	window.setTimeout(walkCat, CAT_PAUSE)
}

onEveryPage(setupPhone)
onEveryPage(bounceHomeIcon)
onEveryPage(setupReveal)
onEveryPage(updateReadingProgress)
onEveryPage(setupPins)
onEveryPage(updateNavbar)
onEveryPage(moveNavPill)
onEveryPage(updateScrollRing)
onEveryPage(setupCountUp)
onEveryPage(setupImageSkeletons)
onEveryPage(setupGithubCalendar)
onEveryPage(updateArticleToc)

// Article contents in the sidebar ([data-article-toc]): highlights the section being read,
// the last heading above the upper third of the screen
function updateArticleToc() {
	const toc = document.querySelector<HTMLElement>("[data-article-toc]")
	if (!toc) return
	const links = [...toc.querySelectorAll<HTMLAnchorElement>("a[href^='#']")]
	const line = window.innerHeight / 3
	let current: HTMLAnchorElement | undefined = links[0]
	for (const link of links) {
		const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)))
		if (heading && heading.getBoundingClientRect().top < line) current = link
	}
	for (const link of links) link.classList.toggle("toc-active", link === current)
}
window.addEventListener("scroll", updateArticleToc, { passive: true })

// Custom cursor on mouse devices: a ring that follows the pointer and grows over things you can click
function setupCursor() {
	if (!matchMedia("(pointer: fine)").matches || matchMedia("(prefers-reduced-motion: reduce)").matches) return
	const ring = document.createElement("div")
	ring.id = "cursor-ring"
	ring.setAttribute("aria-hidden", "true")
	document.body.appendChild(ring)
	let x = -100, y = -100, rx = -100, ry = -100
	window.addEventListener("pointermove", (event) => {
		x = event.clientX
		y = event.clientY
		const target = event.target as HTMLElement | null
		ring.classList.toggle("cursor-hover", !!target?.closest?.("a, button, label, [role='button'], img, input, select, textarea"))
		ring.classList.add("cursor-visible")
	}, { passive: true })
	document.addEventListener("pointerleave", () => ring.classList.remove("cursor-visible"))
	document.addEventListener("pointerdown", () => ring.classList.add("cursor-down"))
	document.addEventListener("pointerup", () => ring.classList.remove("cursor-down"))
	const follow = () => {
		rx += (x - rx) * 0.22
		ry += (y - ry) * 0.22
		ring.style.transform = `translate(${rx}px, ${ry}px)`
		requestAnimationFrame(follow)
	}
	requestAnimationFrame(follow)
}
setupCursor()

// A tiny vibration when tapping buttons and links on phones that support it
document.addEventListener("pointerdown", (event) => {
	if (event.pointerType !== "touch") return
	if ((event.target as HTMLElement | null)?.closest?.("a, button, label, [role='button']")) navigator.vibrate?.(8)
}, { passive: true })

document.addEventListener("click", (event) => {
	const img = (event.target as HTMLElement | null)?.closest?.("img")
	const gallery = img?.closest<HTMLElement>("[data-gallery]")
	if (!img || !gallery || event.ctrlKey || event.metaKey || event.shiftKey) return
	event.preventDefault()
	openGallery(gallery, img)
})

const setup = () => {
	if (!lightbox) {
		createPhotoSwipe()
	}
	window.swup.hooks.on("page:view", () => {
		createPhotoSwipe()
	})

	window.swup.hooks.on(
		"content:replace",
		() => {
			lightbox?.destroy?.()
		},
		{ before: true },
	)
}

if (window.swup) {
	setup()
} else {
	document.addEventListener("swup:enable", setup)
}
</script>
