---
import I18nKey from "../i18n/i18nKey";
import { toLang } from "../i18n/lang";
import { useTranslations } from "../i18n/translation";
import { localeUrl } from "../utils/url-utils";

interface Props {
	totalProjects: number;
	totalBlogs: number;
	totalWebsites: number;
	totalSolutions?: number;
}

const {
	totalProjects,
	totalBlogs,
	totalWebsites,
	totalSolutions = 14,
} = Astro.props;

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);

const services = [
	{
		title: t(I18nKey.applications),
		count: totalProjects,
		icon: "M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
		description: t(I18nKey.applicationsDescription),
		href: localeUrl("/projects/", lang),
		showPlus: true,
	},
	{
		title: t(I18nKey.websites),
		count: totalWebsites,
		icon: "M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9",
		description: t(I18nKey.websitesDescription),
		href: localeUrl("/projects/", lang),
		showPlus: true,
	},
	{
		title: t(I18nKey.blogPosts),
		count: totalBlogs,
		icon: "M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z",
		description: t(I18nKey.blogPostsDescription),
		href: localeUrl("/blogs/", lang),
		showPlus: true,
	},
	{
		title: t(I18nKey.solutions),
		count: totalSolutions,
		icon: "M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z",
		description: t(I18nKey.solutionsDescription),
		href: localeUrl("/blogs/", lang),
		showPlus: false,
	},
];
---

<section aria-label={t(I18nKey.services)}>
  <div class="grid grid-cols-2 xl:grid-cols-4 gap-3 md:gap-4">
    {services.map((service) => (
      <a
        href={service.href}
        class="card-base group p-4 md:p-5 flex flex-col gap-2 active:scale-[0.98] transition duration-200"
      >
        <div class="flex items-center justify-between gap-2">
          <div class="w-10 h-10 md:w-11 md:h-11 shrink-0 bg-[var(--primary-solid)] rounded-[var(--radius-btn)] flex items-center justify-center">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5 md:h-6 md:w-6 text-[var(--on-primary)]"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d={service.icon}
              />
            </svg>
          </div>
          <p class="text-3xl md:text-4xl font-black tracking-tight text-[var(--primary)] leading-none">
            {service.count}{service.showPlus ? '+' : ''}
          </p>
        </div>
        <h3 class="text-base md:text-lg font-extrabold tracking-tight text-[var(--ink)] group-hover:text-[var(--primary)] transition mt-2">
          {service.title}
        </h3>
        <p class="text-sm text-50 leading-snug line-clamp-2">
          {service.description}
        </p>
      </a>
    ))}
  </div>
</section>