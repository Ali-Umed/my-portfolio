---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";
import { url } from "../../utils/url-utils";
import ImageWrapper from "../misc/ImageWrapper.astro";

const config = profileConfig;
const avatar = config.avatar || "";
// Remote and /public avatars can be cropped with a plain <img>; src/ assets still need ImageWrapper
const isPlainImage = avatar.startsWith("http") || avatar.startsWith("/");
---
<div class="card-base p-4">
    <a aria-label="Go to About Page" href={url('/about/')}
       class="group flex items-center gap-3 rounded-xl active:scale-[0.98] transition">
        <div class="relative w-16 h-16 shrink-0 rounded-xl overflow-hidden shadow-md">
            {isPlainImage
                ? <img src={avatar.startsWith("/") ? url(avatar) : avatar} alt="Profile Image of the Author"
                       class="w-full h-full object-cover transition group-hover:scale-110" />
                : <ImageWrapper src={avatar} alt="Profile Image of the Author" class="w-full h-full"></ImageWrapper>}
        </div>
        <div class="min-w-0">
            <div class="font-bold text-lg text-90 leading-tight group-hover:text-[var(--primary)] transition">{config.name}</div>
            <div class="text-sm text-[var(--primary)] flex items-center gap-0.5">
                About me
                <Icon name="material-symbols:arrow-forward-rounded" class="text-sm transition group-hover:translate-x-0.5"></Icon>
            </div>
        </div>
    </a>
    <div class="text-sm text-neutral-400 mt-3 mb-3 transition">{config.bio}</div>
    <div class="flex gap-2">
        {config.links.map(item =>
            <a rel="me" aria-label={item.name} href={item.url} target="_blank" class="btn-regular rounded-lg h-9 flex-1 active:scale-90">
                <Icon name={item.icon} class="text-[1.25rem]"></Icon>
            </a>
        )}
    </div>
</div>
