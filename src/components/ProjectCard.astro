---
import { Image } from "astro:assets";
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { languages, toLang } from "../i18n/lang";
import { getTagName } from "../i18n/tags";
import { useTranslations } from "../i18n/translation";
import { localizePost } from "../utils/content-utils";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getPostUrlBySlug, url } from "../utils/url-utils";

interface Props {
	entry: CollectionEntry<"posts">;
	// Wide card with a bigger cover, for the projects at the top of the list
	featured?: boolean;
	class?: string;
	style?: string;
}

const { entry, featured = false, style } = Astro.props;
const className = Astro.props.class;
const { icon, category, tags, published, screenshots, website } = entry.data;

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const post = await localizePost(entry, lang);
const { title, description } = post;

// "Name - Subtitle" titles are split so the name reads like an app name
const dashIndex = title.indexOf(" - ");
const name = dashIndex > 0 ? title.slice(0, dashIndex) : title;
const subtitle = dashIndex > 0 ? title.slice(dashIndex + 3) : "";

const { remarkPluginFrontmatter } = await post.content.render();
const summary = description || remarkPluginFrontmatter.excerpt;
const isMobile = category === "Mobile Application";

// Posts without a Kurdish translation keep their English summary, left to right, on the Kurdish site
const summaryLang = languages[post.lang];

// Cover: app screenshots peeking up from the bottom edge, or a browser window for websites
const shots = screenshots.slice(0, featured ? 4 : 3);
const domain = website ? new URL(website).hostname.replace(/^www\./, "") : "";
---
<a href={getPostUrlBySlug(entry.slug, lang)}
   class:list={["project-card card-base group flex flex-col h-full active:scale-[0.98] transition duration-200", className]}
   style={style}>
    <div class:list={["relative overflow-hidden border-b border-[var(--card-border)]", featured ? "aspect-[2/1] md:aspect-[5/2]" : "aspect-[2/1]"]}
         aria-hidden="true">
        {shots.length > 0 ? (
            <div class="absolute inset-x-0 top-[12%] flex justify-center gap-3 px-6 transition duration-300 group-hover:-translate-y-1.5">
                {shots.map((shot, index) => (
                    <Image src={shot} alt="" width={featured ? 360 : 300} loading="lazy"
                           class:list={["h-auto rounded-xl border border-[var(--card-border)]", featured ? "w-[28%] md:w-[21%]" : "w-[28%]",
                               { "hidden md:block": index === 3 }]} />
                ))}
            </div>
        ) : (
            <div class="absolute inset-x-[12%] top-[14%] -bottom-4 flex flex-col rounded-xl border border-[var(--card-border)] bg-[var(--card-bg)] transition duration-300 group-hover:-translate-y-1.5">
                <div class="flex items-center gap-1.5 h-8 px-3 shrink-0 border-b border-[var(--card-border)]" dir="ltr">
                    <span class="w-2.5 h-2.5 rounded-full bg-[#ff5f57]"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-[#febc2e]"></span>
                    <span class="w-2.5 h-2.5 rounded-full bg-[#28c840]"></span>
                    <span class="ms-2 min-w-0 flex-1 h-5 px-3 rounded-full bg-[var(--btn-regular-bg)] text-[0.6875rem] font-bold text-50 leading-5 text-center truncate">{domain || name}</span>
                </div>
                <div class="flex-1 flex flex-col items-center justify-center gap-2 pb-4">
                    {icon
                        ? <img src={url(icon)} alt="" width="56" height="56" loading="lazy" class="w-14 h-14 rounded-2xl border border-[var(--card-border)]" />
                        : <div class="w-14 h-14 rounded-2xl bg-[var(--primary-solid)] text-[var(--on-primary)] font-black text-2xl flex items-center justify-center">{name.charAt(0)}</div>}
                    <span class="max-w-[90%] font-extrabold text-sm text-[var(--ink)] truncate">{name}</span>
                </div>
            </div>
        )}
    </div>

    <div class="flex flex-col flex-1 gap-4 p-5">
        <div class="flex items-center gap-4">
            {icon
                ? <img src={url(icon)} alt="" width="56" height="56" loading="lazy"
                       class="w-14 h-14 shrink-0 rounded-2xl border border-[var(--card-border)]" />
                : <div class="w-14 h-14 shrink-0 rounded-2xl bg-[var(--primary-solid)] text-[var(--on-primary)] font-black text-2xl flex items-center justify-center">
                    {name.charAt(0)}
                  </div>}
            <div class="min-w-0">
                <div class="font-extrabold tracking-tight text-lg text-[var(--ink)] leading-tight truncate group-hover:text-[var(--primary)] transition">{name}</div>
                {subtitle && <div class="text-sm text-50 truncate">{subtitle}</div>}
                <div class="chip mt-1.5 px-2 py-0.5 text-xs">
                    <Icon name={isMobile ? "material-symbols:smartphone-outline" : "material-symbols:language"} class="text-sm"></Icon>
                    {t(isMobile ? I18nKey.mobileApp : I18nKey.website)}
                </div>
            </div>
        </div>

        <p class="text-sm text-75 line-clamp-2" lang={summaryLang.htmlLang} dir={summaryLang.dir}>{summary}</p>

        <div class="mt-auto flex items-center justify-between gap-3">
            <div class="flex flex-wrap gap-1.5 min-w-0 overflow-hidden max-h-6">
                {tags.slice(0, 3).map((tag) => (
                    <span class="text-xs px-2.5 py-0.5 rounded-full border border-[var(--card-border)] text-75 font-bold whitespace-nowrap">{getTagName(tag, lang)}</span>
                ))}
            </div>
            <span class="shrink-0 inline-flex items-center gap-1 text-sm font-extrabold h-9 px-4 rounded-[var(--radius-btn)] bg-[var(--primary-solid)] text-[var(--on-primary)] transition">
                {t(I18nKey.view)}
                <Icon name="material-symbols:arrow-forward-rounded" class="text-base transition rtl:-scale-x-100 group-hover:translate-x-1 rtl:group-hover:-translate-x-1"></Icon>
            </span>
        </div>
    </div>
    <time class="sr-only" datetime={published.toISOString()}>{formatDateToYYYYMMDD(published)}</time>
</a>
