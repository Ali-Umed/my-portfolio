---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { formatDateToYYYYMMDD } from "../utils/date-utils";
import { getPostUrlBySlug, url } from "../utils/url-utils";

interface Props {
	entry: CollectionEntry<"posts">;
	class?: string;
	style?: string;
}

const { entry, style } = Astro.props;
const className = Astro.props.class;
const { title, description, icon, category, tags, published } = entry.data;

// "Name - Subtitle" titles are split so the name reads like an app name
const dashIndex = title.indexOf(" - ");
const name = dashIndex > 0 ? title.slice(0, dashIndex) : title;
const subtitle = dashIndex > 0 ? title.slice(dashIndex + 3) : "";

const { remarkPluginFrontmatter } = await entry.render();
const summary = description || remarkPluginFrontmatter.excerpt;
const isMobile = category === "Mobile Application";
---
<a href={getPostUrlBySlug(entry.slug)}
   class:list={["project-card card-base group flex flex-col gap-4 p-5 h-full hover:bg-[var(--card-hover-bg)] active:scale-[0.98] transition duration-200", className]}
   style={style}>
    <div class="flex items-center gap-4">
        {icon
            ? <img src={url(icon)} alt="" width="64" height="64" loading="lazy"
                   class="w-16 h-16 shrink-0 rounded-2xl border border-[var(--card-border)] transition duration-200 group-hover:scale-110 group-hover:-rotate-6" />
            : <div class="w-16 h-16 shrink-0 rounded-2xl bg-[var(--primary-solid)] text-[var(--on-primary)] font-black text-2xl flex items-center justify-center transition duration-200 group-hover:scale-110 group-hover:-rotate-6">
                {name.charAt(0)}
              </div>}
        <div class="min-w-0">
            <div class="font-extrabold tracking-tight text-lg text-[var(--ink)] leading-tight truncate group-hover:text-[var(--primary)] transition">{name}</div>
            {subtitle && <div class="text-sm text-50 truncate">{subtitle}</div>}
            <div class="chip mt-1.5 px-2 py-0.5 text-xs">
                <Icon name={isMobile ? "material-symbols:smartphone-outline" : "material-symbols:language"} class="text-sm"></Icon>
                {isMobile ? "Mobile app" : "Website"}
            </div>
        </div>
    </div>

    <p class="text-sm text-75 line-clamp-2">{summary}</p>

    <div class="mt-auto flex items-center justify-between gap-3">
        <div class="flex flex-wrap gap-1.5 min-w-0 overflow-hidden max-h-6">
            {tags.slice(0, 3).map((tag) => (
                <span class="text-xs px-2.5 py-0.5 rounded-full border border-[var(--card-border)] text-75 font-bold whitespace-nowrap">{tag}</span>
            ))}
        </div>
        <span class="shrink-0 inline-flex items-center gap-1 text-sm font-extrabold h-9 px-4 rounded-[var(--radius-btn)] bg-[var(--primary-solid)] text-[var(--on-primary)] group-hover:brightness-110 transition">
            View
            <Icon name="material-symbols:arrow-forward-rounded" class="text-base transition group-hover:translate-x-1"></Icon>
        </span>
    </div>
    <time class="sr-only" datetime={published.toISOString()}>{formatDateToYYYYMMDD(published)}</time>
</a>
