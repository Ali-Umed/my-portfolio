---
import type { CollectionEntry } from "astro:content";
import { profileConfig } from "../config";
import { getPostUrlBySlug, url } from "../utils/url-utils";

interface Props {
	projects: CollectionEntry<"posts">[];
}

const { projects } = Astro.props;

// Pixel geometry of public/images/projects.png (606x1312): 4x4 home-screen grid
const IMAGE_W = 606;
const IMAGE_H = 1312;
const COLS = [64, 205, 346, 487];
const ROWS = [145, 297, 449, 601];
const ICON = 95;
const LABEL = 30;

// Icon file in each grid cell, matched to a post through its `icon` frontmatter
const grid = [
	["gula-baibun", "mang", "sawda-pro", "spectramind"],
	["ocean-road", "quote", "noon1968", "nilnuts"],
	["weather", "change-life-travels", "quiz", "fast-order"],
	["panel-line", "calculator", "sawda-web"],
];

const pct = (value: number, total: number) => `${(value / total) * 100}%`;

const hotspots = grid.flatMap((row, r) =>
	row.flatMap((icon, c) => {
		// Gula Baibun has a mobile and a web post; the phone icon opens the app
		const post =
			projects.find(
				(p) =>
					p.data.icon === `/images/icons/${icon}.png` &&
					p.data.category === "Mobile Application",
			) ?? projects.find((p) => p.data.icon === `/images/icons/${icon}.png`);
		if (!post) return [];
		return [
			{
				href: getPostUrlBySlug(post.slug),
				title: post.data.title,
				style: `left:${pct(COLS[c], IMAGE_W)};top:${pct(ROWS[r], IMAGE_H)};width:${pct(ICON, IMAGE_W)};height:${pct(ICON + LABEL, IMAGE_H)}`,
			},
		];
	}),
);

const email = profileConfig.links.find((link) =>
	link.url.startsWith("mailto:"),
);
// Dock: Safari opens all projects, Messages opens email
const dock = [
	{ href: url("/projects/"), title: "See all projects", left: 208 },
	...(email ? [{ href: email.url, title: "Get in touch", left: 343 }] : []),
].map((item) => ({
	...item,
	style: `left:${pct(item.left, IMAGE_W)};top:${pct(1198, IMAGE_H)};width:${pct(ICON, IMAGE_W)};height:${pct(ICON, IMAGE_H)}`,
}));
---
<section class="card-base p-6 md:p-8">
    <h2 class="text-3xl font-bold text-center mb-2 text-black dark:text-white">
        My Web and Application Projects
    </h2>
    <p class="text-sm text-50 text-center mb-6">Tap any app on the phone to open it</p>
    <div class="flex justify-center">
        <div class="phone relative w-3/4 sm:w-2/3 md:w-1/2 max-w-4xl">
            <img src={url("/images/projects.png")} alt="Phone home screen showing my apps"
                 class="w-full rounded-lg shadow-lg select-none" draggable="false" />
            {[...hotspots, ...dock].map((spot) => (
                <a href={spot.href} title={spot.title} aria-label={spot.title}
                   class="app-hotspot absolute group" style={spot.style}>
                    <span class="app-hotspot-icon"></span>
                </a>
            ))}
        </div>
    </div>
</section>

<style>
    .app-hotspot-icon {
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        aspect-ratio: 1;
        border-radius: 23%;
        transition: transform 150ms ease, box-shadow 150ms ease, background-color 150ms ease;
    }
    .app-hotspot:hover .app-hotspot-icon,
    .app-hotspot:focus-visible .app-hotspot-icon {
        box-shadow: 0 0 0 3px var(--primary), 0 8px 20px rgb(0 0 0 / 0.25);
        transform: translateY(-2px);
    }
    .app-hotspot:active .app-hotspot-icon {
        background-color: rgb(0 0 0 / 0.25);
        transform: scale(0.92);
    }
    .app-hotspot:focus-visible {
        outline: none;
    }
    /* Gently pulse the icons once on load so visitors notice they are tappable */
    .phone .app-hotspot-icon {
        animation: hint 1.6s ease-out 1.2s 1;
    }
    @keyframes hint {
        0%, 100% { box-shadow: 0 0 0 0 transparent; }
        40% { box-shadow: 0 0 0 3px var(--primary); }
    }
</style>
