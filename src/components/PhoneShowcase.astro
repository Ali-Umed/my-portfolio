---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { toLang } from "../i18n/lang";
import { useTranslations } from "../i18n/translation";
import { localizePost } from "../utils/content-utils";
import { getPostUrlBySlug, localeUrl, url } from "../utils/url-utils";

interface Props {
	projects: CollectionEntry<"posts">[];
}

const { projects } = Astro.props;
const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);

// Pixel geometry of public/images/projects.png (606x1312): 4x4 home-screen grid
const IMAGE_W = 606;
const IMAGE_H = 1312;
const COLS = [64, 205, 346, 487];
const ROWS = [145, 297, 449, 601];
const ICON = 95;
const LABEL = 30;

// Icon file in each grid cell, matched to a post through its `icon` frontmatter
const grid = [
	["gula-baibun", "mang", "sawda-pro", "spectramind"],
	["ocean-road", "quote", "noon1968", "nilnuts"],
	["weather", "change-life-travels", "quiz", "fast-order"],
	["panel-line", "calculator", "sawda-web"],
];

const pct = (value: number, total: number) => `${(value / total) * 100}%`;

// Hover titles in the page's language
const titles = new Map(
	await Promise.all(
		projects.map(
			async (p) => [p.slug, (await localizePost(p, lang)).title] as const,
		),
	),
);

const hotspots = grid.flatMap((row, r) =>
	row.flatMap((icon, c) => {
		// Gula Baibun has a mobile and a web post; the phone icon opens the app
		const post =
			projects.find(
				(p) =>
					p.data.icon === `/images/icons/${icon}.png` &&
					p.data.category === "Mobile Application",
			) ?? projects.find((p) => p.data.icon === `/images/icons/${icon}.png`);
		if (!post) return [];
		return [
			{
				icon: url(`/images/icons/${icon}.png`),
				href: getPostUrlBySlug(post.slug, lang),
				title: titles.get(post.slug) ?? post.data.title,
				style: `left:${pct(COLS[c], IMAGE_W)};top:${pct(ROWS[r], IMAGE_H)};width:${pct(ICON, IMAGE_W)};height:${pct(ICON + LABEL, IMAGE_H)}`,
			},
		];
	}),
);

// Dock: favourite apps (the dock area of projects.png is empty, these sit on top of it)
const DOCK_SLUGS = ["moon", "gwllabaybun", "spectramindgpt"];
const DOCK_CENTER = 323;
// Dock runs from y 1163 to about 1292 in the picture; icons are a bit smaller than the grid's and centred in it
const DOCK_ICON = 84;
const DOCK_TOP = 1186;
const DOCK_GAP = 36;
const dockApps = DOCK_SLUGS.map((slug) => projects.find((p) => p.slug === slug)).filter(
	(post): post is CollectionEntry<"posts"> => !!post?.data.icon,
);
const dockStart = DOCK_CENTER - (dockApps.length * DOCK_ICON + (dockApps.length - 1) * DOCK_GAP) / 2;
const dock = dockApps.map((post, index) => ({
	icon: url(post.data.icon as string),
	href: getPostUrlBySlug(post.slug, lang),
	title: titles.get(post.slug) ?? post.data.title,
	style: `left:${pct(dockStart + index * (DOCK_ICON + DOCK_GAP), IMAGE_W)};top:${pct(DOCK_TOP, IMAGE_H)};width:${pct(DOCK_ICON, IMAGE_W)};height:${pct(DOCK_ICON, IMAGE_H)}`,
	dock: true,
}));
---
<section class="card-base p-6 md:p-8">
    <div class="flex justify-center mb-3">
        <span class="chip h-8 px-3 text-xs">
            <span class="w-2 h-2 rounded-full bg-[var(--primary)]"></span>
            {t(I18nKey.showcaseChip, { count: projects.length })}
        </span>
    </div>
    <h2 class="text-3xl md:text-4xl font-black tracking-tight text-center mb-2 text-[var(--ink)]">
        {t(I18nKey.showcaseTitle)}
    </h2>
    <p class="text-base font-medium text-50 text-center mb-6">{t(I18nKey.showcaseHint)}</p>
    <div class="flex justify-center">
        <!-- Tilts with the visitor's phone or mouse; holding an app makes the icons wiggle (setupPhone in Layout.astro) -->
        <div class="phone relative w-3/4 sm:w-2/3 md:w-1/2 max-w-4xl" data-phone>
            <img src={url("/images/projects.png")} alt={t(I18nKey.showcaseImageAlt)}
                 class="w-full select-none" draggable="false" />
            <!-- Live clock in the status bar, where the picture's own clock was (setupPhone in Layout.astro) -->
            <time data-phone-clock dir="ltr" aria-hidden="true"
                  class="absolute font-semibold text-white leading-none tabular-nums pointer-events-none select-none"
                  style="left:13.7%;top:4.46%;transform:translateY(-50%);font-size:3.8cqw;letter-spacing:-0.01em">00:00</time>
            {[...hotspots, ...dock].map((spot) => (
                <a href={spot.href} title={spot.title} aria-label={spot.title}
                   class:list={["app-hotspot absolute group", { "dock-app": "dock" in spot }]} style={spot.style} draggable="false">
                    <span class="app-hotspot-icon">
                        <img src={spot.icon} alt="" width="96" height="96" draggable="false" class="w-full h-full rounded-[23%] select-none" />
                    </span>
                </a>
            ))}
        </div>
    </div>
    <div class="flex flex-wrap justify-center gap-3 mt-6">
        <a href={localeUrl("/projects/", lang)} class="btn-bold">
            {t(I18nKey.seeAllProjects)}
            <Icon name="material-symbols:arrow-forward-rounded" class="text-xl rtl:-scale-x-100"></Icon>
        </a>
        <a href={localeUrl("/blogs/", lang)} class="btn-outline">{t(I18nKey.readMyBlog)}</a>
    </div>
</section>

<style>
    .app-hotspot {
        -webkit-touch-callout: none;
        -webkit-user-select: none;
        user-select: none;
    }
    .app-hotspot-icon {
        display: block;
        position: absolute;
        left: 0;
        top: 0;
        width: 100%;
        aspect-ratio: 1;
        border-radius: 23%;
        transition: transform 150ms ease, box-shadow 150ms ease, background-color 150ms ease;
    }
    /* Dock icons: iPhone-style rounded corners, clipped cleanly, with a soft shadow on the dock */
    .dock-app .app-hotspot-icon {
        border-radius: 22.5%;
        overflow: hidden;
        box-shadow: 0 2px 6px rgb(0 0 0 / 0.18), 0 0 0 0.5px rgb(0 0 0 / 0.12);
    }
    .dock-app .app-hotspot-icon img {
        border-radius: 0;
    }
    .app-hotspot:hover .app-hotspot-icon,
    .app-hotspot:focus-visible .app-hotspot-icon {
        box-shadow: 0 0 0 3px var(--primary);
        transform: translateY(-2px);
    }
    .app-hotspot:active .app-hotspot-icon {
        background-color: rgb(0 0 0 / 0.25);
        transform: scale(0.92);
    }
    .app-hotspot:focus-visible {
        outline: none;
    }
    /* Gently pulse the icons once on load so visitors notice they are tappable */
    .phone .app-hotspot-icon {
        animation: hint 1.6s ease-out 1.2s 1;
    }
    @keyframes hint {
        0%, 100% { box-shadow: 0 0 0 0 transparent; }
        40% { box-shadow: 0 0 0 3px var(--primary); }
    }
</style>

<style is:global>
    /* Wiggle while an app is held, like editing an iPhone home screen */
    [data-phone] {
        container-type: inline-size;
        transition: transform 0.25s ease-out;
        transform-style: preserve-3d;
    }
    [data-phone].jiggle .app-hotspot-icon {
        animation: jiggle 0.28s ease-in-out infinite alternate;
    }
    [data-phone].jiggle .app-hotspot:nth-child(odd) .app-hotspot-icon {
        animation-delay: -0.14s;
    }
    @keyframes jiggle {
        from { transform: rotate(-2.5deg); }
        to { transform: rotate(2.5deg); }
    }
    @media (prefers-reduced-motion: reduce) {
        [data-phone].jiggle .app-hotspot-icon { animation: none; }
    }
</style>
