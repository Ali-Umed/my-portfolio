---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../config";
import { getNavBarLinks } from "../constants/link-presets";
import I18nKey from "../i18n/i18nKey";
import { toLang } from "../i18n/lang";
import { useTranslations } from "../i18n/translation";
import { localeUrl } from "../utils/url-utils";

const currentYear = new Date().getFullYear();

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);
const links = getNavBarLinks(lang);
const email = profileConfig.links.find((link) =>
	link.url.startsWith("mailto:"),
);
---

<footer class="card-base mt-4 mb-8 p-6 md:p-8">
    <div class="flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
            <div class="font-black tracking-tight text-2xl md:text-3xl text-[var(--ink)]">{t(I18nKey.footerHeading)}</div>
            <p class="text-sm font-medium text-50 mt-1">{t(I18nKey.profileBio)}</p>
        </div>
        {email && (
            <a href={email.url}
               class="btn-bold shrink-0 self-start md:self-auto">
                <Icon name="material-symbols:mail-outline-rounded" class="text-xl"></Icon>
                {t(I18nKey.getInTouch)}
            </a>
        )}
    </div>

    <div class="border-t border-dashed border-black/10 dark:border-white/[0.15] my-6"></div>

    <div class="flex flex-col-reverse sm:flex-row sm:items-center justify-between gap-4">
        <div class="text-sm font-medium text-50">
            © {currentYear} {profileConfig.name}. {t(I18nKey.allRightsReserved)}
        </div>
        <nav class="flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
            {links.map((link) => (
                <a href={link.external ? link.url : localeUrl(link.url, lang)}
                   target={link.external ? "_blank" : null}
                   class="font-bold text-[var(--ink)] hover:text-[var(--primary)] transition">
                    {link.name}
                </a>
            ))}
            <span class="hidden sm:block w-px h-4 bg-black/10 dark:bg-white/15"></span>
            <div class="flex gap-2">
                {profileConfig.links.map((link) => (
                    <a href={link.url} target="_blank" rel="me" aria-label={link.name}
                       class="btn-round w-10 h-10">
                        <Icon name={link.icon} class="text-lg"></Icon>
                    </a>
                ))}
            </div>
        </nav>
    </div>
</footer>
