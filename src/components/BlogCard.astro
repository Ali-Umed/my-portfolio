---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { formatDate, languages, toLang } from "../i18n/lang";
import { useTranslations } from "../i18n/translation";
import { getBlogPlatform } from "../utils/blog-utils";
import { localeUrl } from "../utils/url-utils";

interface Props {
	entry: CollectionEntry<"blogs">;
	class?: string;
	style?: string;
}

const { entry, style } = Astro.props;
const className = Astro.props.class;
const { title, description, category, published, lang } = entry.data;

const platform = getBlogPlatform(category);
const platformIcon = {
	android: "fa6-brands:android",
	ios: "fa6-brands:apple",
	other: "material-symbols:article-outline-rounded",
}[platform];

// The card is in the article's own language: Kurdish posts read right-to-left, so the whole card mirrors
const postLang = toLang(lang);
const { htmlLang, dir } = languages[postLang];
const t = useTranslations(postLang);
const { remarkPluginFrontmatter } = await entry.render();
const summary = description || remarkPluginFrontmatter.excerpt;
const date = formatDate(published, postLang, {
	year: "numeric",
	month: "short",
	day: "numeric",
});
---
<a href={localeUrl(`/blogs/${entry.slug}/`, toLang(Astro.currentLocale))} dir={dir} lang={htmlLang}
   class:list={["card-base group flex gap-3 md:gap-4 p-5 md:p-6 active:scale-[0.99] transition", className]}
   style={style}>
    <div class="w-10 h-10 md:w-11 md:h-11 shrink-0 rounded-xl bg-[var(--primary-solid)] text-[var(--on-primary)] flex items-center justify-center mt-1">
        <Icon name={platformIcon} class="text-xl md:text-[1.375rem]"></Icon>
    </div>
    <div class="min-w-0 flex-1 flex flex-col gap-2">
        <h2 class="font-extrabold tracking-tight text-xl md:text-2xl leading-snug text-[var(--ink)] group-hover:text-[var(--primary)] transition">
            {title}
        </h2>
        <p class="text-sm md:text-base font-medium text-75 line-clamp-2">{summary}</p>
        <div class="flex flex-wrap items-center gap-2 mt-1">
            {category && <span class="chip h-7 px-2.5 text-xs">{category}</span>}
            <span class="chip h-7 px-2.5 text-xs" dir="auto">{postLang === "ku" ? languages.ku.name : "EN"}</span>
            <span class="chip h-7 px-2.5 text-xs">
                <Icon name="material-symbols:schedule-outline-rounded" class="text-sm"></Icon>
                {t(I18nKey.minutesShort, { minutes: remarkPluginFrontmatter.minutes })}
            </span>
            <time class="text-xs font-bold text-50 px-1" datetime={published.toISOString()}>{date}</time>
            <span class="ms-auto inline-flex items-center gap-1 text-sm font-extrabold h-9 px-4 rounded-[var(--radius-btn)] bg-[var(--primary-solid)] text-[var(--on-primary)]">
                {t(I18nKey.read)}
                <!-- Not rtl: variants: those follow the page, and this card can be LTR inside the Kurdish site -->
                <Icon name="material-symbols:arrow-forward-rounded" class:list={["text-base transition",
                    dir === "rtl" ? "-scale-x-100 group-hover:-translate-x-1" : "group-hover:translate-x-1"]}></Icon>
            </span>
        </div>
    </div>
</a>
