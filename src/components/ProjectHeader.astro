---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import I18nKey from "../i18n/i18nKey";
import { formatDate, toLang } from "../i18n/lang";
import { getTagName } from "../i18n/tags";
import { useTranslations } from "../i18n/translation";
import CopyLinkButton from "./misc/CopyLinkButton.astro";
import { getTagUrl, url } from "../utils/url-utils";

interface Props {
	entry: CollectionEntry<"posts">;
	// Title in the page's language (see localizePost)
	title: string;
	minutes: number;
}

const { entry, title, minutes } = Astro.props;
const { icon, category, tags, published, appStore, playStore, website, github } =
	entry.data;

// Same "Name - Subtitle" split as the project cards
const dashIndex = title.indexOf(" - ");
const name = dashIndex > 0 ? title.slice(0, dashIndex) : title;
const subtitle = dashIndex > 0 ? title.slice(dashIndex + 3) : "";
const isMobile = category === "Mobile Application";

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);

// First available link is the solid primary button, the rest are outlined
const actions = [
	appStore && { href: appStore, label: "App Store", icon: "fa6-brands:apple" },
	playStore && { href: playStore, label: "Google Play", icon: "fa6-brands:google-play" },
	website && { href: website, label: t(I18nKey.visitWebsite), icon: "material-symbols:language" },
	github && { href: github, label: t(I18nKey.sourceCode), icon: "fa6-brands:github" },
].filter(Boolean) as { href: string; label: string; icon: string }[];

const date = formatDate(published, lang, { year: "numeric", month: "short" });
const goUrl = new URL(`/go/${entry.slug}/`, Astro.site).href;
---
<header class="mb-6">
    <div class="flex flex-col sm:flex-row sm:items-center gap-5">
        {icon
            ? <img src={url(icon)} alt={t(I18nKey.appIconAlt, { name })} width="112" height="112"
                   class="w-24 h-24 md:w-28 md:h-28 shrink-0 rounded-[22%] border border-[var(--card-border)]" />
            : <div class="w-24 h-24 md:w-28 md:h-28 shrink-0 rounded-[22%] bg-[var(--primary-solid)] text-[var(--on-primary)] font-black text-5xl flex items-center justify-center">
                {name.charAt(0)}
              </div>}
        <div class="min-w-0">
            <h1 data-pagefind-body data-pagefind-weight="10" data-pagefind-meta={`title:${title}`}
                class="font-black tracking-tight text-3xl md:text-4xl leading-tight text-[var(--ink)]">
                {name}
            </h1>
            {subtitle && <p class="text-base md:text-lg font-bold text-50 mt-1">{subtitle}</p>}
            <div class="flex flex-wrap items-center gap-2 mt-3">
                <span class="chip h-7 px-2.5 text-xs">
                    <Icon name={isMobile ? "material-symbols:smartphone-outline" : "material-symbols:language"} class="text-sm"></Icon>
                    {t(isMobile ? I18nKey.mobileApp : I18nKey.website)}
                </span>
                <span class="chip h-7 px-2.5 text-xs">
                    <Icon name="material-symbols:calendar-today-outline-rounded" class="text-sm"></Icon>
                    {date}
                </span>
                <span class="chip h-7 px-2.5 text-xs">
                    <Icon name="material-symbols:schedule-outline-rounded" class="text-sm"></Icon>
                    {t(I18nKey.minRead, { minutes })}
                </span>
                <CopyLinkButton />
            </div>
        </div>
    </div>

    {actions.length > 0 && (
        <div class="flex flex-wrap gap-3 mt-6">
            {actions.map((action, index) => (
                <a href={action.href} target="_blank" rel="noopener"
                   class:list={[index === 0 ? "btn-bold" : "btn-outline"]}>
                    <Icon name={action.icon} class="text-xl"></Icon>
                    {action.label}
                </a>
            ))}
        </div>
    )}

    <!-- One QR code for the app: /go/<project>/ sends iPhones to the App Store and Android phones to Google Play -->
    {(appStore || playStore) && (
        <div class="hidden md:flex mt-5">
            <a href={goUrl} target="_blank" rel="noopener"
               class="flex items-center gap-3 rounded-2xl border border-[var(--card-border)] p-2 pe-4 hover:border-[var(--primary)] transition">
                <img src={`https://api.qrserver.com/v1/create-qr-code/?size=180x180&margin=0&data=${encodeURIComponent(goUrl)}`}
                     alt="" width="72" height="72" loading="lazy" class="w-[4.5rem] h-[4.5rem] rounded-lg bg-white p-1" />
                <span class="text-sm">
                    <span class="flex items-center gap-1.5 font-extrabold text-[var(--ink)]">
                        {appStore && <Icon name="fa6-brands:apple" class="text-base"></Icon>}
                        {playStore && <Icon name="fa6-brands:google-play" class="text-sm"></Icon>}
                        {t(I18nKey.getTheApp)}
                    </span>
                    <span class="block text-50 font-bold">{t(I18nKey.scanToOpen)}</span>
                </span>
            </a>
        </div>
    )}

    {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 mt-5">
            {tags.map((tag) => (
                <a href={getTagUrl(tag, lang)} class="chip h-7 px-2.5 text-xs">{getTagName(tag, lang)}</a>
            ))}
        </div>
    )}
</header>
<div class="border-[var(--line-divider)] border-dashed border-b-[1px] mb-6"></div>
