---
import type { CollectionEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import { getPostUrlBySlug, url } from "../utils/url-utils";

interface Props {
	projects: CollectionEntry<"posts">[];
}

const { projects } = Astro.props;

// Apps that have both a mobile and a web post share one name; keep it short
const shortName = (title: string) => {
	const dashIndex = title.indexOf(" - ");
	return dashIndex > 0 ? title.slice(0, dashIndex) : title;
};
---
<section class="card-base p-6 md:p-8">
    <div class="flex items-end justify-between gap-4 mb-6">
        <div>
            <h2 class="text-2xl md:text-3xl font-bold text-90">My Web and Application Projects</h2>
            <p class="text-sm text-50 mt-1">Tap an app to open its page</p>
        </div>
        <a href={url("/projects/")}
           class="btn-regular shrink-0 rounded-lg px-3 h-9 text-sm font-bold gap-1 active:scale-95">
            See all
            <Icon name="material-symbols:arrow-forward-rounded" class="text-base"></Icon>
        </a>
    </div>
    <div class="grid grid-cols-4 sm:grid-cols-5 md:grid-cols-6 gap-x-3 gap-y-5">
        {projects.map((post) => {
            const name = shortName(post.data.title);
            const isMobile = post.data.category === "Mobile Application";
            return (
                <a href={getPostUrlBySlug(post.slug)} title={post.data.title}
                   class="group flex flex-col items-center gap-2 text-center">
                    <div class="relative">
                        {post.data.icon
                            ? <img src={url(post.data.icon)} alt="" width="64" height="64" loading="lazy"
                                   class="w-14 h-14 md:w-16 md:h-16 rounded-2xl shadow-md transition group-hover:-translate-y-1 group-hover:shadow-xl group-active:scale-90" />
                            : <div class="w-14 h-14 md:w-16 md:h-16 rounded-2xl shadow-md bg-[var(--primary)] text-white dark:text-black/80 font-bold text-2xl flex items-center justify-center transition group-hover:-translate-y-1 group-active:scale-90">
                                {name.charAt(0)}
                              </div>}
                        <span class="absolute -bottom-1 -right-1 w-5 h-5 rounded-full bg-[var(--card-bg)] flex items-center justify-center text-[var(--primary)]">
                            <Icon name={isMobile ? "material-symbols:smartphone-outline" : "material-symbols:language"} class="text-xs"></Icon>
                        </span>
                    </div>
                    <span class="text-xs text-75 leading-tight line-clamp-2 group-hover:text-[var(--primary)] transition">{name}</span>
                </a>
            );
        })}
    </div>
</section>
